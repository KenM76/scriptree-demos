{
  "schema_version": 3,
  "name": "gh \u2014 PR list",
  "description": "List pull requests in a GitHub repository.\n\nA pull request (PR) is a proposed change someone has made on a side branch and wants merged into the main code. This form shows them \u2014 open ones, closed ones, drafts, whatever you filter for. Useful when you want to see 'what's everyone working on right now' or 'what's waiting on me to review'.\n\nDefaults to OPEN pull requests in the repository of the current working directory. Fill in 'Repository' to look at a different repo. Use the Filter section to narrow down by state, author, branch, labels, or a free-form GitHub search query. Source: https://cli.github.com/manual/gh_pr_list",
  "executable": "gh",
  "working_directory": null,
  "argument_template": [
    "pr",
    "list",
    [
      "-R",
      "{repo}"
    ],
    [
      "-s",
      "{state}"
    ],
    "{draft?-d}",
    [
      "-A",
      "{author}"
    ],
    [
      "-a",
      "{assignee}"
    ],
    [
      "-B",
      "{base}"
    ],
    [
      "-H",
      "{head}"
    ],
    [
      "-l",
      "{label}"
    ],
    "{label_extra}",
    [
      "-m",
      "{milestone}"
    ],
    [
      "--app",
      "{app}"
    ],
    [
      "-S",
      "{search}"
    ],
    [
      "-L",
      "{limit}"
    ],
    [
      "--json",
      "{json}"
    ],
    [
      "-q",
      "{jq}"
    ],
    [
      "-t",
      "{template}"
    ],
    "{web?-w}"
  ],
  "params": [
    {
      "id": "repo",
      "label": "Repository (-R / --repo)",
      "description": "Which GitHub project to look at. Format is 'OWNER/REPO' (e.g. 'cli/cli' for github.com/cli/cli, or 'microsoft/vscode' for github.com/microsoft/vscode). Leave blank if you've already cd'd into a clone of the repo on your machine \u2014 gh will figure it out from the folder.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Repo"
    },
    {
      "id": "state",
      "label": "State (-s / --state)",
      "description": "Which PRs to include based on their lifecycle stage:\n  open    \u2014 still being worked on / under review\n  closed  \u2014 closed without being merged (rejected, abandoned, superseded)\n  merged  \u2014 accepted and merged into the target branch\n  all     \u2014 everything regardless of state\nLeave blank to default to 'open' (the most common pick).",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "",
      "choices": [
        "",
        "open",
        "closed",
        "merged",
        "all"
      ],
      "section": "Filter"
    },
    {
      "id": "draft",
      "label": "Drafts only (-d / --draft)",
      "description": "A 'draft' PR is one the author has marked as not-yet-ready-for-review (work-in-progress). Tick this to see only those, untick to see ready-for-review PRs alongside drafts.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filter"
    },
    {
      "id": "author",
      "label": "Author (-A / --author)",
      "description": "Show only PRs opened by this person. Use a GitHub username (e.g. 'octocat') or '@me' for yourself. For PRs opened by a bot, use 'app/<name>' (e.g. 'app/dependabot').",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "assignee",
      "label": "Assignee (-a / --assignee)",
      "description": "Show only PRs assigned to this person (the person responsible for shepherding it through review). Use a GitHub username or '@me' for yourself.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "base",
      "label": "Base branch (-B / --base)",
      "description": "The 'base' branch is the one a PR wants to merge INTO \u2014 usually 'main'. Set this to filter to PRs targeting a specific branch (e.g. 'main' to ignore PRs targeting old release branches, or 'develop' if the project uses a develop-then-main flow).",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "head",
      "label": "Head branch (-H / --head)",
      "description": "The 'head' branch is the one a PR was written ON \u2014 the branch with the changes. Set this to filter to PRs whose source branch matches (e.g. 'feature/new-login'). Useful when you've made commits on a topic branch and want to find the PR for it.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "label",
      "label": "Label (-l / --label)",
      "description": "Show only PRs that have this coloured tag attached. Common labels: 'bug', 'enhancement', 'good first issue', 'priority:high'. Each repo defines its own. Repeatable \u2014 use the field below for additional labels (multiple labels means 'must have ALL of these').",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "label_extra",
      "label": "Extra --label entries (repeatable)",
      "description": "Additional label filters. Write the full flag for each entry. Example:\n    -l bug -l priority:high",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "milestone",
      "label": "Milestone (-m / --milestone)",
      "description": "A 'milestone' is a grouping for PRs/issues aimed at a particular goal or version (e.g. 'v2.0', 'Q3 2026'). Filter to PRs attached to a specific milestone by name or number.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "app",
      "label": "GitHub App author (--app)",
      "description": "Filter to PRs opened by a specific GitHub App (e.g. 'dependabot').",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "search",
      "label": "Search query (-S / --search)",
      "description": "Power-user filter using GitHub's full search syntax \u2014 the same query language you'd type in the search bar on github.com. Mix and match with the simpler filters above.\n\nExamples:\n  review:approved              \u2014 only PRs that have been approved\n  comments:>5                  \u2014 PRs with more than 5 comments\n  is:open draft:false          \u2014 open, ready-for-review PRs\n  created:>2026-01-01          \u2014 opened this year\n  involves:@me                 \u2014 anything you're involved in",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "limit",
      "label": "Limit (-L / --limit)",
      "description": "Maximum number of PRs to show. Default is 30 if left blank. Bump it to 100+ on busy repos where 30 isn't enough; lower it to 5\u201310 if you just want a quick top-of-list peek.",
      "type": "integer",
      "widget": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 1000,
      "section": "Filter"
    },
    {
      "id": "json",
      "label": "JSON fields (--json)",
      "description": "Switch to machine-readable JSON output for scripting. Comma-separated list of which fields to include (e.g. 'number,title,state,author'). For exploring what's available, run `gh pr list --json` with nothing after it \u2014 gh will print every field name it knows. Leave blank for human-friendly table output.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "jq",
      "label": "jq filter (-q / --jq)",
      "description": "Apply a jq expression to the JSON output. Implies --json. Example: '.[] | .title'.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "template",
      "label": "Go template (-t / --template)",
      "description": "Go template applied to JSON output. Implies --json. Example: '{{range .}}{{.number}} {{.title}}{{\"\\n\"}}{{end}}'.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "web",
      "label": "Open in browser (-w / --web)",
      "description": "Skip printing the list to the terminal and open the same view in your default browser instead. Handy when you want to click through and read the actual PR pages, not just see a list.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Output"
    }
  ],
  "source": {
    "mode": "manual",
    "url": "https://cli.github.com/manual/gh_pr_list",
    "help_text_cached": "gh pr list [flags]\n\nFlags:\n  -A, --author <user>     Filter by author\n  -a, --assignee <user>   Filter by assignee\n  -B, --base <branch>     Filter by base branch\n  -H, --head <branch>     Filter by head branch\n  -d, --draft             Filter by draft state\n  -l, --label <label>     Filter by label (repeatable)\n  -m, --milestone <name>  Filter by milestone\n  -s, --state <state>     open|closed|merged|all\n      --app <name>        Filter by GitHub App author\n  -S, --search <query>    Search syntax\n  -L, --limit <n>         Max PRs to fetch (default 30)\n      --json <fields>     JSON output\n  -q, --jq <expr>         jq expression\n  -t, --template <tpl>    Go template\n  -w, --web               Open in browser\n  -R, --repo <repo>       Target repository"
  }
}
