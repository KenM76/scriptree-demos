{
  "schema_version": 2,
  "name": "gh — issue list",
  "description": "List issues in a GitHub repository.\n\nAn 'issue' on GitHub is a public conversation thread attached to a project — usually a bug report, a feature request, or a question. Anyone can open one; the project's maintainers triage them, label them, and close them when resolved. This form is for browsing them.\n\nDefaults to OPEN issues in the repository of the current working directory. Use the Filter section to narrow by author, assignee, labels, milestone, or a free-form GitHub search query. Source: https://cli.github.com/manual/gh_issue_list",
  "executable": "gh",
  "working_directory": null,
  "argument_template": [
    "issue",
    "list",
    ["-R", "{repo}"],
    ["-s", "{state}"],
    ["-A", "{author}"],
    ["-a", "{assignee}"],
    ["--mention", "{mention}"],
    ["-l", "{label}"],
    "{label_extra}",
    ["-m", "{milestone}"],
    ["--app", "{app}"],
    ["-S", "{search}"],
    ["-L", "{limit}"],
    ["--json", "{json}"],
    ["-q", "{jq}"],
    ["-t", "{template}"],
    "{web?-w}"
  ],
  "params": [
    {
      "id": "repo",
      "label": "Repository (-R / --repo)",
      "description": "Which GitHub project to look at. Format is 'OWNER/REPO' (e.g. 'cli/cli'). Leave blank if you've already cd'd into a clone of the repo on your machine — gh figures it out from the folder.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Repo"
    },
    {
      "id": "state",
      "label": "State (-s / --state)",
      "description": "Which issues to include based on their lifecycle stage:\n  open    — still being discussed / unresolved\n  closed  — resolved or dismissed\n  all     — everything regardless of state\nLeave blank to default to 'open' (the most common pick).",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "",
      "choices": ["", "open", "closed", "all"],
      "section": "Filter"
    },
    {
      "id": "author",
      "label": "Author (-A / --author)",
      "description": "Show only issues opened by this person. Use a GitHub username (e.g. 'octocat') or '@me' for yourself.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "assignee",
      "label": "Assignee (-a / --assignee)",
      "description": "Show only issues assigned to this person (the person responsible for working on them). Use a GitHub username or '@me' for yourself — '@me' is the easiest way to see 'what's on my plate'.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "mention",
      "label": "Mentions (--mention)",
      "description": "Filter to issues that mention this login.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "label",
      "label": "Label (-l / --label)",
      "description": "Show only issues that have this coloured tag attached. Common labels: 'bug', 'enhancement', 'documentation', 'good first issue', 'help wanted'. Each repo defines its own. Use the field below to add more labels (multiple labels means 'must have ALL of these').",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "label_extra",
      "label": "Extra --label entries (repeatable)",
      "description": "Additional label filters. Write the full flag for each. Example:\n    -l bug -l priority:high",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "milestone",
      "label": "Milestone (-m / --milestone)",
      "description": "A 'milestone' is a grouping for issues aimed at a particular goal or version (e.g. 'v2.0', 'Q3 2026'). Filter to issues attached to a specific milestone by name or number.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "app",
      "label": "GitHub App author (--app)",
      "description": "Filter to issues opened by a specific GitHub App.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "search",
      "label": "Search query (-S / --search)",
      "description": "Power-user filter using GitHub's full search syntax — the same query language you'd type in the search bar on github.com. Mix and match with the simpler filters above.\n\nExamples:\n  is:open label:bug                  — open issues labelled 'bug'\n  created:>2026-01-01                — opened this year\n  involves:@me                       — anything you're involved in\n  comments:>10 sort:comments-desc    — busiest issues first",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filter"
    },
    {
      "id": "limit",
      "label": "Limit (-L / --limit)",
      "description": "Maximum number of issues to show. Default is 30 if left blank. Bump it to 100+ on busy repos; lower it for a quick top-of-list peek.",
      "type": "integer",
      "widget": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 1000,
      "section": "Filter"
    },
    {
      "id": "json",
      "label": "JSON fields (--json)",
      "description": "Comma-separated list of fields to return as JSON. Run `gh issue list --json` for the full field list.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "jq",
      "label": "jq filter (-q / --jq)",
      "description": "Apply a jq expression to the JSON output. Implies --json.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "template",
      "label": "Go template (-t / --template)",
      "description": "Go template applied to JSON output. Implies --json.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "web",
      "label": "Open in browser (-w / --web)",
      "description": "Skip printing the list to the terminal and open the same view in your default browser instead. Handy when you want to click through and read the actual issues.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Output"
    }
  ],
  "source": {
    "mode": "manual",
    "url": "https://cli.github.com/manual/gh_issue_list"
  }
}
