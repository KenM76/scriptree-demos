{
  "schema_version": 2,
  "name": "gh — PR view",
  "description": "Read one pull request from the terminal — its title, current state (open/merged/closed), the description the author wrote, and (optionally) the comment thread.\n\nA pull request (PR) is someone's proposed change to a project. This form is for reading one specific PR; if you don't know which one yet, use 'gh pr list' first to find it.\n\nIdentify the PR by its number ('1234'), full URL, or the branch name it was made from. Leave blank to view the PR for whatever branch you currently have checked out locally. Source: https://cli.github.com/manual/gh_pr_view",
  "executable": "gh",
  "working_directory": null,
  "argument_template": [
    "pr",
    "view",
    "{pr}",
    ["-R", "{repo}"],
    "{comments?-c}",
    ["--json", "{json}"],
    ["-q", "{jq}"],
    ["-t", "{template}"],
    "{web?-w}"
  ],
  "params": [
    {
      "id": "pr",
      "label": "PR (number, URL, or branch)",
      "description": "Which pull request to show. You can identify it three ways:\n  - Number:  1234         (the # GitHub assigned the PR)\n  - URL:     https://github.com/owner/repo/pull/1234\n  - Branch:  feature/my-branch    (the branch the PR was made from)\n\nLeave blank to view the PR for whichever branch you currently have checked out — useful when you've just opened a PR and want to inspect it.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Target"
    },
    {
      "id": "repo",
      "label": "Repository (-R / --repo)",
      "description": "Which GitHub project to look at. Format is 'OWNER/REPO' (e.g. 'cli/cli'). Leave blank if you've already cd'd into a clone of the repo on your machine — gh will figure it out from the folder.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Target"
    },
    {
      "id": "comments",
      "label": "Show comments (-c / --comments)",
      "description": "Also print the comment discussion thread (people's questions, feedback, and review remarks). Off by default because comment threads can be long. Tick this when you want the full back-and-forth, not just the description.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Detail"
    },
    {
      "id": "json",
      "label": "JSON fields (--json)",
      "description": "Comma-separated list of fields to return as JSON. Run `gh pr view --json` for the full field list.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "jq",
      "label": "jq filter (-q / --jq)",
      "description": "Apply a jq expression to the JSON output. Implies --json.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "template",
      "label": "Go template (-t / --template)",
      "description": "Go template applied to JSON output. Implies --json.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "web",
      "label": "Open in browser (-w / --web)",
      "description": "Skip the terminal output and open the PR in your default browser instead. Better for reading rich content (diff highlighting, inline comments, screenshots posted by reviewers).",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Output"
    }
  ],
  "source": {
    "mode": "manual",
    "url": "https://cli.github.com/manual/gh_pr_view"
  }
}
