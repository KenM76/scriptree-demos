{
  "schema_version": 3,
  "name": "gh \u2014 issue view",
  "description": "Read one issue from the terminal \u2014 its title, current state (open or closed), labels, the original description, and (optionally) the comment thread.\n\nAn 'issue' on GitHub is a public conversation about a bug, a feature request, or a question. This form is for reading one specific issue; if you don't know which one yet, use 'gh issue list' first to find it.\n\nIdentify the issue by its number ('1234') or full URL. Source: https://cli.github.com/manual/gh_issue_view",
  "executable": "gh",
  "working_directory": null,
  "argument_template": [
    "issue",
    "view",
    "{issue}",
    [
      "-R",
      "{repo}"
    ],
    "{comments?-c}",
    [
      "--json",
      "{json}"
    ],
    [
      "-q",
      "{jq}"
    ],
    [
      "-t",
      "{template}"
    ],
    "{web?-w}"
  ],
  "params": [
    {
      "id": "issue",
      "label": "Issue (number or URL)",
      "description": "Which issue to show. Identify it by:\n  - Number:  1234     (the # GitHub assigned the issue)\n  - URL:     https://github.com/owner/repo/issues/1234\nRequired.",
      "type": "string",
      "widget": "text",
      "required": true,
      "default": "",
      "section": "Target"
    },
    {
      "id": "repo",
      "label": "Repository (-R / --repo)",
      "description": "Which GitHub project to look at. Format is 'OWNER/REPO' (e.g. 'cli/cli'). Leave blank if you've already cd'd into a clone of the repo on your machine.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Target"
    },
    {
      "id": "comments",
      "label": "Show comments (-c / --comments)",
      "description": "Also print the comment discussion thread (replies, follow-up questions, debugging notes from other users). Off by default because comment threads can be long. Tick this when you want the full back-and-forth, not just the original post.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Detail"
    },
    {
      "id": "json",
      "label": "JSON fields (--json)",
      "description": "Comma-separated list of fields to return as JSON.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "jq",
      "label": "jq filter (-q / --jq)",
      "description": "Apply a jq expression to the JSON output. Implies --json.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "template",
      "label": "Go template (-t / --template)",
      "description": "Go template applied to JSON output. Implies --json.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "web",
      "label": "Open in browser (-w / --web)",
      "description": "Skip the terminal output and open the issue in your default browser instead. Better for reading rich content (screenshots, code blocks with syntax highlighting, formatted comments).",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Output"
    }
  ],
  "source": {
    "mode": "manual",
    "url": "https://cli.github.com/manual/gh_issue_view"
  }
}
