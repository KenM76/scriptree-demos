{
  "schema_version": 2,
  "name": "gh — PR create",
  "description": "Propose your changes by opening a pull request (PR).\n\nThe usual workflow this fits into:\n  1. You clone a repository.\n  2. You make a side branch and commit your changes there.\n  3. You push the side branch up to GitHub.\n  4. You run THIS form to ask the project to merge your side branch into their main branch.\n\nThe PR is a formal request — it includes a title, a description, and a discussion thread where reviewers can ask questions and request changes before it's merged.\n\nThis form needs to be run from inside a clone of the repo, on the branch you want to propose. The 'Body' tab lets you write the PR description; the 'People & metadata' tab lets you request reviews and apply labels. Use 'Draft' (in the State tab) if it's not ready for review yet, or 'Dry run' (Submission tab) to preview without actually opening the PR. Source: https://cli.github.com/manual/gh_pr_create",
  "executable": "gh",
  "working_directory": null,
  "sections": [
    { "name": "Repo", "layout": "tab" },
    { "name": "Branches", "layout": "tab" },
    { "name": "Body", "layout": "tab" },
    { "name": "State", "layout": "tab" },
    { "name": "People & metadata", "layout": "tab" },
    { "name": "Submission", "layout": "tab" }
  ],
  "argument_template": [
    "pr",
    "create",
    ["-R", "{repo}"],
    ["-t", "{title}"],
    ["-b", "{body}"],
    ["-F", "{body_file}"],
    "{draft?-d}",
    "{fill?-f}",
    "{fill_first?--fill-first}",
    "{fill_verbose?--fill-verbose}",
    ["-B", "{base}"],
    ["-H", "{head}"],
    ["-a", "{assignee}"],
    "{assignee_extra}",
    ["-r", "{reviewer}"],
    "{reviewer_extra}",
    ["-l", "{label}"],
    "{label_extra}",
    ["-m", "{milestone}"],
    ["-p", "{project}"],
    ["-T", "{template_file}"],
    "{no_maintainer_edit?--no-maintainer-edit}",
    "{editor?-e}",
    "{web?-w}",
    "{dry_run?--dry-run}",
    ["--recover", "{recover}"]
  ],
  "params": [
    {
      "id": "repo",
      "label": "Repository (-R / --repo)",
      "description": "Which GitHub project the PR is being filed against. Format is 'OWNER/REPO' (e.g. 'cli/cli'). Leave blank if you're running this from inside a local clone of the repo — gh figures it out from the folder.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Repo"
    },
    {
      "id": "base",
      "label": "Base branch (-B / --base)",
      "description": "The branch your changes should be merged INTO — usually 'main'. This is the official version of the code that you want your changes added to. Leave blank to use the repo's default branch (almost always 'main' or 'master').",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Branches"
    },
    {
      "id": "head",
      "label": "Head branch (-H / --head)",
      "description": "The branch that HAS your changes — the one you want merged. Defaults to whichever branch you currently have checked out, which is what you usually want.\n\nIf you're proposing changes from your fork of someone else's repo, use the format 'OWNER:branch' (e.g. 'octocat:my-fix') so GitHub knows it's coming from a different account.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Branches"
    },
    {
      "id": "title",
      "label": "Title (-t / --title)",
      "description": "A short, one-line summary of what the PR does. Shown at the top of the PR and in lists. Aim for under 70 characters. Examples: 'Fix crash on login when password contains emoji', 'Add dark mode toggle to settings'.\n\nRequired UNLESS you're using --fill (auto-fill from commits), --editor (open your editor to compose), or --web (open the GitHub create-page in a browser).",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Body"
    },
    {
      "id": "body",
      "label": "Body (-b / --body)",
      "description": "The longer description of what the PR does and why. This is where you explain context — what problem you're solving, how you tested it, anything reviewers should know. Markdown is supported.\n\nFor anything more than a sentence or two, use 'Body file' below or tick 'Use editor' (in the Submission tab) to compose in your text editor.",
      "type": "string",
      "widget": "textarea",
      "required": false,
      "default": "",
      "section": "Body"
    },
    {
      "id": "body_file",
      "label": "Body file (-F / --body-file)",
      "description": "Read the PR description from this file. Use '-' to read from stdin.",
      "type": "path",
      "widget": "file_open",
      "required": false,
      "default": "",
      "section": "Body"
    },
    {
      "id": "template_file",
      "label": "PR template file (-T / --template)",
      "description": "Use a non-default PR template by file name (e.g. 'bugfix.md'). The repo's .github/PULL_REQUEST_TEMPLATE/ folder lists the available templates.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Body"
    },
    {
      "id": "fill",
      "label": "Auto-fill from commits (-f / --fill)",
      "description": "Skip writing a title/body manually and use the commit messages from the branch instead. The first commit's one-line summary becomes the PR title; the remaining commit messages become the body. Tick this when your commits are already well-written and you don't want to repeat yourself.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Body"
    },
    {
      "id": "fill_first",
      "label": "Fill from first commit only (--fill-first)",
      "description": "Use only the first commit's message for both title and body. Handy when subsequent commits are noisy fixups.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Body"
    },
    {
      "id": "fill_verbose",
      "label": "Fill verbose (--fill-verbose)",
      "description": "Include the full commit body (not just the subject) when filling.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Body"
    },
    {
      "id": "draft",
      "label": "Draft (-d / --draft)",
      "description": "Open the PR with a 'Draft' marker meaning 'not ready to be reviewed yet'. You can keep pushing commits to the branch; reviewers will (politely) wait for you to mark it ready before they look. Useful when you want feedback on a work-in-progress, or to share early so others don't duplicate your effort.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "State"
    },
    {
      "id": "no_maintainer_edit",
      "label": "Disable maintainer edits (--no-maintainer-edit)",
      "description": "Block upstream maintainers from editing the PR head branch. Only relevant for cross-fork PRs.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "State"
    },
    {
      "id": "assignee",
      "label": "Assignee (-a / --assignee)",
      "description": "The person responsible for shepherding this PR (usually you, the author). Use a GitHub username (e.g. 'octocat') or '@me' for yourself.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "People & metadata"
    },
    {
      "id": "assignee_extra",
      "label": "Extra --assignee entries (repeatable)",
      "description": "Additional assignees. Write the full flag for each. Example:\n    -a alice -a bob",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "People & metadata"
    },
    {
      "id": "reviewer",
      "label": "Reviewer (-r / --reviewer)",
      "description": "Ask a specific person (or team) to review your code before it merges. Use a GitHub username (e.g. 'octocat') or a team in 'org/team-name' form (e.g. 'github/security'). They'll get a notification and the PR shows up on their review dashboard.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "People & metadata"
    },
    {
      "id": "reviewer_extra",
      "label": "Extra --reviewer entries (repeatable)",
      "description": "Additional reviewers. Write the full flag for each. Example:\n    -r alice -r github/platform",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "People & metadata"
    },
    {
      "id": "label",
      "label": "Label (-l / --label)",
      "description": "Attach a coloured tag to the PR for sorting and triage. Each repo defines its own labels — common ones are 'bug', 'enhancement', 'documentation'. Use the field below to add more labels (multiple labels are fine).",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "People & metadata"
    },
    {
      "id": "label_extra",
      "label": "Extra --label entries (repeatable)",
      "description": "Additional labels. Write the full flag for each. Example:\n    -l bug -l priority:high",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "People & metadata"
    },
    {
      "id": "milestone",
      "label": "Milestone (-m / --milestone)",
      "description": "Attach to a milestone by name.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "People & metadata"
    },
    {
      "id": "project",
      "label": "Project (-p / --project)",
      "description": "Add the PR to a Project (Beta) by title.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "People & metadata"
    },
    {
      "id": "editor",
      "label": "Use editor (-e / --editor)",
      "description": "Drop into $EDITOR to compose title/body interactively.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Submission"
    },
    {
      "id": "web",
      "label": "Open in browser (-w / --web)",
      "description": "Skip submitting from the CLI and open GitHub's web 'create PR' page in your browser instead. The branch info is pre-filled; you finish the title/body in the browser. Use this when you want GitHub's rich web editor (image paste, drag-drop attachments, live Markdown preview).",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Submission"
    },
    {
      "id": "dry_run",
      "label": "Dry run (--dry-run)",
      "description": "Show what gh WOULD send to GitHub without actually creating the PR. Safe way to verify the title, body, branches, reviewers, and labels are right before committing — nothing is published. Useful when scripting or when you're unsure about the form.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Submission"
    },
    {
      "id": "recover",
      "label": "Recover from file (--recover)",
      "description": "Recover input from a previous failed run by file path. gh writes recovery files when submission fails partway.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Submission"
    }
  ],
  "source": {
    "mode": "manual",
    "url": "https://cli.github.com/manual/gh_pr_create"
  }
}
