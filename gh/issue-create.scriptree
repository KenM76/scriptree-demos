{
  "schema_version": 3,
  "name": "gh \u2014 issue create",
  "description": "File a new issue against a GitHub project \u2014 typically a bug report or a feature request, but it can be any conversation you want to start with the maintainers.\n\nThe issue is public: anyone visiting the repo can read it, and maintainers will respond by closing it (resolved/dismissed), tagging it with labels for triage, or asking follow-up questions.\n\nTitle and a short description are usually all you need. For longer prose use 'Body file' (read from a file) or tick 'Use editor' (in the Submission tab) to compose in your text editor. Source: https://cli.github.com/manual/gh_issue_create",
  "executable": "gh",
  "working_directory": null,
  "sections": [
    {
      "name": "Repo",
      "layout": "tab"
    },
    {
      "name": "Body",
      "layout": "tab"
    },
    {
      "name": "Metadata",
      "layout": "tab"
    },
    {
      "name": "Submission",
      "layout": "tab"
    }
  ],
  "argument_template": [
    "issue",
    "create",
    [
      "-R",
      "{repo}"
    ],
    [
      "-t",
      "{title}"
    ],
    [
      "-b",
      "{body}"
    ],
    [
      "-F",
      "{body_file}"
    ],
    [
      "-a",
      "{assignee}"
    ],
    "{assignee_extra}",
    [
      "-l",
      "{label}"
    ],
    "{label_extra}",
    [
      "-m",
      "{milestone}"
    ],
    [
      "-p",
      "{project}"
    ],
    [
      "-T",
      "{template_name}"
    ],
    "{editor?-e}",
    "{web?-w}",
    [
      "--recover",
      "{recover}"
    ]
  ],
  "params": [
    {
      "id": "repo",
      "label": "Repository (-R / --repo)",
      "description": "Which GitHub project the issue is being filed against. Format is 'OWNER/REPO' (e.g. 'cli/cli'). Leave blank if you've already cd'd into a clone of the repo.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Repo"
    },
    {
      "id": "title",
      "label": "Title (-t / --title)",
      "description": "A short, one-line summary of the issue. Shown at the top of the issue page and in the issue list. Be specific \u2014 'Login button does nothing on Safari 17' is far more useful than 'Login broken'. Aim for under 70 characters.\n\nRequired UNLESS you tick 'Use editor' (compose in your editor) or 'Open in browser' (compose on github.com).",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Body"
    },
    {
      "id": "body",
      "label": "Body (-b / --body)",
      "description": "The longer description of the issue. For bug reports include: what you expected to happen, what actually happened, steps to reproduce, your environment (OS, version of the tool). For feature requests: what you want and why. Markdown is supported.\n\nFor anything more than a sentence or two, use 'Body file' below or tick 'Use editor' (in the Submission tab) to compose in your text editor.",
      "type": "string",
      "widget": "textarea",
      "required": false,
      "default": "",
      "section": "Body"
    },
    {
      "id": "body_file",
      "label": "Body file (-F / --body-file)",
      "description": "Read the issue description from this file. Use '-' to read from stdin.",
      "type": "path",
      "widget": "file",
      "required": false,
      "default": "",
      "section": "Body"
    },
    {
      "id": "template_name",
      "label": "Issue template (-T / --template)",
      "description": "Name of the issue template to use (from .github/ISSUE_TEMPLATE/). Example: 'bug_report.md'.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Body"
    },
    {
      "id": "assignee",
      "label": "Assignee (-a / --assignee)",
      "description": "Assign the issue to this login. '@me' = assign to yourself.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Metadata"
    },
    {
      "id": "assignee_extra",
      "label": "Extra --assignee entries (repeatable)",
      "description": "Additional assignees. Write the full flag for each. Example:\n    -a alice -a bob",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Metadata"
    },
    {
      "id": "label",
      "label": "Label (-l / --label)",
      "description": "Attach a coloured tag for sorting and triage. Each repo defines its own labels \u2014 common ones are 'bug', 'enhancement', 'question', 'documentation'. Use the field below to add more.\n\nNote: most projects expect maintainers (not reporters) to apply labels \u2014 check the project's contributing guide.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Metadata"
    },
    {
      "id": "label_extra",
      "label": "Extra --label entries (repeatable)",
      "description": "Additional labels. Write the full flag for each. Example:\n    -l bug -l priority:high",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Metadata"
    },
    {
      "id": "milestone",
      "label": "Milestone (-m / --milestone)",
      "description": "Attach to a milestone by name.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Metadata"
    },
    {
      "id": "project",
      "label": "Project (-p / --project)",
      "description": "Add the issue to a Project (Beta) by title.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Metadata"
    },
    {
      "id": "editor",
      "label": "Use editor (-e / --editor)",
      "description": "Drop into $EDITOR to compose title/body interactively.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Submission"
    },
    {
      "id": "web",
      "label": "Open in browser (-w / --web)",
      "description": "Skip submitting from the CLI and open GitHub's web 'create issue' page in your browser instead. Use this when the project has a structured issue template (the GitHub web form will guide you through it), or when you want to paste in a screenshot.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Submission"
    },
    {
      "id": "recover",
      "label": "Recover from file (--recover)",
      "description": "Recover input from a previous failed run. gh writes recovery files when submission fails partway.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Submission"
    }
  ],
  "source": {
    "mode": "manual",
    "url": "https://cli.github.com/manual/gh_issue_create"
  }
}
