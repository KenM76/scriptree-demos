{
  "schema_version": 2,
  "name": "jit — quick lookup",
  "description": "Fetch a Jira ticket by key or Atlassian URL and print a one-screen summary. Use the Output toggles to switch to a single-line form (handy for scripts) or machine-readable JSON. For a richer breakdown (description, comments, linked PRs, metadata) use the 'Show detail' scriptree instead. Source: https://github.com/cesarferreira/jit",
  "executable": "./jit.exe",
  "working_directory": null,
  "argument_template": [
    ["--config-file", "{config_file}"],
    "{text?--text}",
    "{json?--json}",
    "{key}"
  ],
  "params": [
    {
      "id": "key",
      "label": "Issue key or URL",
      "description": "Jira issue key (e.g. RW-123) or a full Atlassian URL to the ticket. jit parses either form.",
      "type": "string",
      "widget": "text",
      "required": true,
      "default": "",
      "section": "Ticket"
    },
    {
      "id": "text",
      "label": "One-line text (--text)",
      "description": "Print a single line of the form 'KEY: Summary'. Great for piping into scripts or shell prompts. Mutually exclusive with JSON — pick one.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Output format"
    },
    {
      "id": "json",
      "label": "JSON (--json)",
      "description": "Emit the ticket as JSON. Mutually exclusive with --text. If both are set, jit will error — leave at most one ticked.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Output format"
    },
    {
      "id": "config_file",
      "label": "Config file (--config-file)",
      "description": "Override the default jit config file. Useful for juggling multiple Jira instances (e.g. a work account and a personal account).",
      "type": "path",
      "widget": "file_open",
      "required": false,
      "default": "",
      "file_filter": "TOML config (*.toml);;All files (*)",
      "section": "Config"
    }
  ],
  "source": {
    "mode": "manual",
    "url": "https://github.com/cesarferreira/jit"
  }
}
