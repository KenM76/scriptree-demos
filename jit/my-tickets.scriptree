{
  "schema_version": 2,
  "name": "jit — my sprint tickets",
  "description": "List the current-sprint tickets assigned to you. Handy first thing in the morning or when prepping for standup. Narrow the result with a row limit, pin to a specific board, or pull in linked PR context to see which items have open code review.",
  "executable": "./jit.exe",
  "working_directory": null,
  "argument_template": [
    ["--config-file", "{config_file}"],
    "--my-tickets",
    ["--limit", "{limit}"],
    ["--board", "{board}"],
    "{include_prs?--include-prs}",
    "{json?--json}"
  ],
  "params": [
    {
      "id": "limit",
      "label": "Row limit (--limit)",
      "description": "Maximum number of tickets to show. Leave blank to use jit's default.",
      "type": "integer",
      "widget": "number",
      "required": false,
      "default": 0,
      "min": 1,
      "max": 500,
      "section": "Filter"
    },
    {
      "id": "board",
      "label": "Board ID (--board)",
      "description": "Numeric Jira board ID. Use this when you're active on multiple boards and want to pin the sprint lookup to a specific one. Leave blank to let jit pick your default board.",
      "type": "integer",
      "widget": "number",
      "required": false,
      "default": 0,
      "min": 1,
      "max": 999999,
      "section": "Filter"
    },
    {
      "id": "include_prs",
      "label": "Linked PRs (--include-prs)",
      "description": "Show linked pull requests next to each ticket. Slower (one extra API call per ticket) but great for triaging what's blocked in review.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filter"
    },
    {
      "id": "json",
      "label": "JSON (--json)",
      "description": "Emit the list as JSON instead of a formatted table.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Output"
    },
    {
      "id": "config_file",
      "label": "Config file (--config-file)",
      "description": "Override the default jit config file. Useful for switching between multiple Jira instances.",
      "type": "path",
      "widget": "file_open",
      "required": false,
      "default": "",
      "file_filter": "TOML config (*.toml);;All files (*)",
      "section": "Config"
    }
  ],
  "source": {
    "mode": "manual",
    "url": "https://github.com/cesarferreira/jit"
  }
}
