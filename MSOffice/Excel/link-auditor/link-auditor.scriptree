{
  "schema_version": 3,
  "name": "Broken External Link Auditor",
  "description": "Audits the external workbook links of the Excel workbook that is currently open and active. For every link source it reports OK (the source file exists), BROKEN (the source file is missing), URL (a web/DDE link that isn't checked on disk), or OFFLINE (the source lives on a drive/share you flagged as currently unavailable, so it is reported without forcing a slow filesystem timeout).\n\nRead-only: this tool never modifies the workbook. Open the workbook you want to audit in Excel first, then Run.\n\nRequires combridge (bundled with ScripTree at lib/combridge) and a running Excel instance.",
  "executable": "python",
  "working_directory": ".",
  "argument_template": [
    "link_auditor.py",
    [
      "--report-mode",
      "{report_mode}"
    ],
    [
      "--offline-drives",
      "{offline_drives}"
    ],
    [
      "--output-format",
      "{output_format}"
    ]
  ],
  "params": [
    {
      "id": "report_mode",
      "label": "Report",
      "description": "Which links to list. 'Broken / offline only' shows just the problems (the default \u2014 what you usually want). 'All external links' lists every external link with its status, useful for a full inventory.",
      "type": "enum",
      "widget": "radio",
      "required": false,
      "default": "broken",
      "choices": [
        "broken",
        "all"
      ],
      "choice_labels": [
        "Broken / offline only",
        "All external links"
      ]
    },
    {
      "id": "offline_drives",
      "label": "Offline drives / shares (optional)",
      "description": "Comma-separated list of drive letters or UNC prefixes that are currently disconnected (e.g. 'X:, \\\\\\\\nas\\\\archive'). Any link source whose path starts with one of these is reported as OFFLINE instead of BROKEN, and is NOT probed on disk \u2014 this avoids a long filesystem timeout when a mapped drive or server is unreachable. Leave blank to probe every link normally.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": ""
    },
    {
      "id": "output_format",
      "label": "Output format",
      "description": "How the report is rendered in the output pane. 'Markdown table' is easy to paste into notes or a ticket; 'Plain text' is a simple aligned list.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "markdown",
      "choices": [
        "markdown",
        "text"
      ],
      "choice_labels": [
        "Markdown table",
        "Plain text"
      ]
    }
  ],
  "source": {
    "mode": "manual",
    "help_text_cached": null
  },
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "category": "MSOffice/Excel"
}