// link_auditor.csx — generated by link_auditor.py (Strategy A shim).
// Do not edit the generated copy; edit link_auditor.csx.template instead.
//
// Runs inside combridge's Excel plugin via `run-script`. Globals available:
//   xlApp   (Xl.Application, never null)
//   xlBook  (Xl.Workbook?,  null when no workbook is open)
//   xlSheet (Xl.Worksheet?, null when the active sheet is a chart)
// Default usings already injected by combridge: System, System.Collections.Generic,
// System.IO, System.Linq, System.Runtime.InteropServices, Microsoft.Office.Interop.Excel.
//
// combridge swallows the script's return value (always exits 0 on a clean run),
// so this script signals state to the shim with a first-line sentinel:
//   __LINKAUDIT__ STATUS=NO_WORKBOOK     -> shim exits 2, shows the message
//   __LINKAUDIT__ STATUS=OK broken=B offline=F  -> shim exits 0
// The shim strips the sentinel line before showing the report.

// --- values baked in by the shim (C# string literals) ---
string reportMode   = "__REPORT_MODE__";    // "broken" | "all"
string offlineInput = "__OFFLINE_DRIVES__";  // comma-separated prefixes, may be empty
string outputFormat = "__OUTPUT_FORMAT__";   // "markdown" | "text"

if (xlBook is null)
{
    Console.WriteLine("__LINKAUDIT__ STATUS=NO_WORKBOOK");
    Console.WriteLine("No workbook is open. Open the workbook you want to audit in Excel, then run again.");
    return 0;
}

// Parse the offline-drive prefixes.
var offlinePrefixes = new List<string>();
foreach (var part in offlineInput.Split(','))
{
    var p = part.Trim();
    if (p.Length > 0) offlinePrefixes.Add(p);
}

bool StartsWithAny(string path, List<string> prefixes)
{
    foreach (var pre in prefixes)
        if (path.StartsWith(pre, StringComparison.OrdinalIgnoreCase)) return true;
    return false;
}

// xlExcelLinks = 1. LinkSources returns an Array of source path strings, or null
// when the workbook has no external links of that kind.
var records = new List<(string source, string status)>();
object raw = xlBook.LinkSources(XlLink.xlExcelLinks);
if (raw is System.Array arr)
{
    foreach (var item in arr)
    {
        string src = item?.ToString() ?? "";
        if (src.Length == 0) continue;
        string status;
        if (src.Contains("://"))
            status = "URL";                       // web/DDE link — not a disk path
        else if (StartsWithAny(src, offlinePrefixes))
            status = "OFFLINE";                   // flagged unavailable — skip the probe
        else if (File.Exists(src))
            status = "OK";
        else
            status = "BROKEN";
        records.Add((src, status));
    }
}

int total = records.Count;
int okCount = 0, brokenCount = 0, offlineCount = 0, urlCount = 0;
foreach (var r in records)
{
    if (r.status == "OK") okCount++;
    else if (r.status == "BROKEN") brokenCount++;
    else if (r.status == "OFFLINE") offlineCount++;
    else if (r.status == "URL") urlCount++;
}

bool problemsOnly = (reportMode != "all");
bool IsProblem(string status) => status == "BROKEN" || status == "OFFLINE";

var shown = new List<(string source, string status)>();
foreach (var r in records)
    if (!problemsOnly || IsProblem(r.status)) shown.Add(r);

// First line is the sentinel for the shim.
Console.WriteLine($"__LINKAUDIT__ STATUS=OK broken={brokenCount} offline={offlineCount}");

string summary = $"{total} external link{(total == 1 ? "" : "s")} - "
               + $"{okCount} OK, {brokenCount} broken, {offlineCount} offline, {urlCount} URL.";

if (total == 0)
{
    Console.WriteLine(outputFormat == "markdown"
        ? "**No external workbook links found.** This workbook has no links to other workbooks."
        : "No external workbook links found. This workbook has no links to other workbooks.");
    return 0;
}

if (problemsOnly && shown.Count == 0)
{
    Console.WriteLine(outputFormat == "markdown"
        ? $"**No broken or offline links found.** ({summary})"
        : $"No broken or offline links found. ({summary})");
    return 0;
}

if (outputFormat == "markdown")
{
    Console.WriteLine(problemsOnly ? "# Broken / offline external links" : "# External link audit");
    Console.WriteLine();
    Console.WriteLine("| Status | Link source |");
    Console.WriteLine("|---|---|");
    foreach (var r in shown)
        Console.WriteLine($"| {r.status} | {r.source.Replace("|", "\\|")} |");
    Console.WriteLine();
    Console.WriteLine($"**Summary:** {summary}");
}
else
{
    string title = problemsOnly ? "Broken / offline external links" : "External link audit";
    Console.WriteLine(title);
    Console.WriteLine(new string('=', title.Length));
    foreach (var r in shown)
        Console.WriteLine($"[{r.status,-7}] {r.source}");
    Console.WriteLine();
    Console.WriteLine("Summary: " + summary);
}

return 0;
