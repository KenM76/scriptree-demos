{
  "schema_version": 3,
  "name": "Multi-CSV Sheet Aggregator (Excel)",
  "description": "Imports every .csv and .txt file in a folder you choose as a separate new sheet in the Excel workbook you already have open \u2014 one sheet per file, each named after its source file. Classic use: a folder of monthly exports (jan.csv, feb.csv, ...) becomes one workbook with a sheet per month, ready to consolidate.\n\nThe files on disk are only READ, never changed. The tool only ADDS sheets to your open workbook (it never overwrites your existing sheets or saves over your file). Because adding sheets is still a change to your workbook, you can tick 'Backup workbook first' to save a '<name>_Backup' copy to disk before any sheet is added. After the import the workbook is left OPEN and UNSAVED so you can review the new sheets and save (or discard) the workbook yourself.\n\nThe delimiter can be auto-detected per file (handles comma, tab, and European semicolon files), or you can force a specific one if auto-detect guesses wrong. Sheet names are sanitised, truncated to Excel's 31-character limit, and de-duplicated automatically. Files that fail to import are skipped and listed in the report; the rest still import.\n\nRequires combridge (bundled with ScripTree at lib/combridge) and a workbook already open in a running Excel instance.",
  "executable": "python",
  "working_directory": ".",
  "argument_template": [
    "csv_aggregator.py",
    [
      "--source-folder",
      "{source_folder}"
    ],
    [
      "--delimiter",
      "{delimiter}"
    ],
    "{backup_first?--backup-first}",
    [
      "--output-format",
      "{output_format}"
    ]
  ],
  "params": [
    {
      "id": "source_folder",
      "label": "Source folder",
      "description": "The folder to scan. Every .csv and .txt file directly inside it is imported as a new sheet (subfolders are not searched). Required.",
      "type": "path",
      "widget": "folder",
      "required": true,
      "default": ""
    },
    {
      "id": "delimiter",
      "label": "Delimiter",
      "description": "How each file's columns are separated. 'Auto-detect' (recommended) inspects each file's first line and picks comma, tab, or semicolon \u2014 this correctly handles European semicolon-delimited CSVs that a plain comma split would mangle. Choose a specific delimiter only if auto-detect guesses wrong for your files.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "auto",
      "choices": [
        "auto",
        "comma",
        "tab",
        "semicolon"
      ],
      "choice_labels": [
        "Auto-detect (recommended)",
        "Comma ( , )",
        "Tab",
        "Semicolon ( ; )"
      ]
    },
    {
      "id": "backup_first",
      "label": "Backup workbook first",
      "description": "When ticked (the default), a '<name>_Backup' copy of the open workbook is saved to disk before any sheet is added \u2014 a safety net you can return to. If the workbook has never been saved there is no folder to put the backup in, so the run is refused; save the workbook once (Ctrl+S) or untick this. Untick to import without making a backup.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true
    },
    {
      "id": "output_format",
      "label": "Output format",
      "description": "How the result summary is rendered in the output pane. 'Markdown' is easy to paste into notes; 'Plain text' is a simple aligned list.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "markdown",
      "choices": [
        "markdown",
        "text"
      ],
      "choice_labels": [
        "Markdown",
        "Plain text"
      ]
    }
  ],
  "source": {
    "mode": "manual",
    "help_text_cached": null
  },
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "category": "MSOffice/Excel"
}