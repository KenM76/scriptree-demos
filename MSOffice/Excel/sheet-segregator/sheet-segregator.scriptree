{
  "schema_version": 3,
  "name": "Column-Based Sheet Segregator (Excel)",
  "description": "Splits the flat table on the active Excel worksheet into separate sheets \u2014 one sheet per distinct value found in a chosen 'key' column. Classic use: a sales export with a 'Region' column becomes one sheet per region, each holding only that region's rows plus a copy of the header.\n\nThe operation never changes your source data. In 'New workbook' mode (the default, safest) the per-value sheets are written into a brand-new workbook and your original is left completely untouched. In 'Add sheets to current workbook' mode the new sheets are appended after the active sheet; the source sheet is only read, and you can tick 'Backup first' to save a '<name>_backup' copy before any sheet is added.\n\nIn both modes the result is left OPEN and UNSAVED in Excel so you can review it and save (or discard) it yourself. A safety cap ('Max distinct values') refuses to run if the key column has more distinct values than the limit \u2014 this guards against accidentally picking a near-unique column (like an ID) and spawning thousands of sheets.\n\nRequires combridge (bundled with ScripTree at lib/combridge) and the target workbook already open in a running Excel instance.",
  "executable": "python",
  "working_directory": ".",
  "argument_template": [
    "sheet_segregator.py",
    [
      "--key-column",
      "{key_column}"
    ],
    "{has_header?--has-header}",
    [
      "--output-mode",
      "{output_mode}"
    ],
    [
      "--sheet-name-prefix",
      "{sheet_name_prefix}"
    ],
    "{backup_first?--backup-first}",
    [
      "--max-groups",
      "{max_groups}"
    ],
    [
      "--output-format",
      "{output_format}"
    ]
  ],
  "params": [
    {
      "id": "key_column",
      "label": "Key column",
      "description": "Which column to split on. You can give the HEADER NAME (e.g. 'Region' \u2014 only when 'First row is a header' is ticked), a COLUMN LETTER (e.g. 'C'), or a 1-based POSITION within the used range (e.g. '3' for the third column of the table). Required.",
      "type": "string",
      "widget": "text",
      "required": true,
      "default": "",
      "no_split": true,
      "section": "Key column"
    },
    {
      "id": "has_header",
      "label": "First row is a header",
      "description": "When ticked (the default), the first row of the table is treated as column headings \u2014 it is copied to the top of every output sheet, and you may name the key column by its heading. Untick if the data starts on row 1 with no header.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true,
      "section": "Key column"
    },
    {
      "id": "output_mode",
      "label": "Where to put the sheets",
      "description": "'New workbook' (recommended) writes the per-value sheets into a fresh workbook and never touches your original. 'Add sheets to current workbook' appends the new sheets after the active sheet in the workbook you already have open.",
      "type": "enum",
      "widget": "radio",
      "required": false,
      "default": "new_workbook",
      "choices": [
        "new_workbook",
        "new_sheets"
      ],
      "choice_labels": [
        "New workbook (recommended)",
        "Add sheets to current workbook"
      ],
      "section": "Output"
    },
    {
      "id": "sheet_name_prefix",
      "label": "Sheet name prefix",
      "description": "Optional text prepended to every created sheet name (e.g. a prefix of 'R-' turns the value 'East' into a sheet named 'R-East'). Leave blank to name each sheet after its key value alone. Illegal characters and over-length names are sanitised automatically.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "no_split": true,
      "section": "Output"
    },
    {
      "id": "backup_first",
      "label": "Backup workbook first (Add-sheets mode only)",
      "description": "Only used in 'Add sheets to current workbook' mode. When ticked (the default), a '<name>_backup' copy of the workbook is saved to disk before any sheet is added. Ignored in 'New workbook' mode (where your original is never touched anyway). If the workbook has never been saved, the run is refused so there is something to back up.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true,
      "section": "Output"
    },
    {
      "id": "max_groups",
      "label": "Max distinct values",
      "description": "Safety cap. If the key column has more distinct values than this, the tool refuses to run rather than create a huge number of sheets \u2014 a guard against accidentally choosing a near-unique column such as an ID or timestamp. Raise it if you genuinely need more sheets.",
      "type": "integer",
      "widget": "number",
      "required": false,
      "default": 50,
      "min": 1,
      "max": 1000,
      "section": "Output"
    },
    {
      "id": "output_format",
      "label": "Output format",
      "description": "How the result summary is rendered in the output pane. 'Markdown' is easy to paste into notes; 'Plain text' is a simple aligned list.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "markdown",
      "choices": [
        "markdown",
        "text"
      ],
      "choice_labels": [
        "Markdown",
        "Plain text"
      ],
      "section": "Output"
    }
  ],
  "sections": [
    {
      "name": "Key column",
      "layout": "collapse"
    },
    {
      "name": "Output",
      "layout": "collapse"
    }
  ],
  "source": {
    "mode": "manual",
    "help_text_cached": null
  },
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "category": "MSOffice/Excel"
}