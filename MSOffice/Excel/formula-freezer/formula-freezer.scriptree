{
  "schema_version": 3,
  "name": "Formula-to-Value Freezer (Excel)",
  "description": "Converts every formula in the open Excel workbook into its current static value \u2014 locking down the calculated data state so the numbers can never silently change again. Classic uses: a month-end snapshot, a figure handed to an auditor, or a file sent outside the company where the source data behind cross-sheet references may be missing.\n\nSafe by default. With 'Work on a copy' left ON (the default), the tool saves a sibling '<name>_Frozen.xlsx', freezes the formulas in that copy, saves and closes it, and leaves your ORIGINAL workbook OPEN and completely UNTOUCHED \u2014 your live formulas survive in the instance you are looking at. Turn 'Work on a copy' OFF to freeze the open workbook in memory instead; it is then left OPEN and UNSAVED for you to review (Ctrl+Z still undoes it). The tool never silently overwrites your original file on disk.\n\nEach formula cell is replaced by the constant it currently produces; cell number formats (dates, currency) are preserved, so only the formulas go away \u2014 the displayed values are identical. If a target worksheet is protected the run is refused (its cells cannot be overwritten) before any change is made.\n\nRequires combridge (bundled with ScripTree at lib/combridge) and the target workbook already open in a running Excel instance.",
  "executable": "python",
  "working_directory": ".",
  "argument_template": [
    "freeze_formulas.py",
    [
      "--scope",
      "{scope}"
    ],
    "{work_on_copy?--work-on-copy}",
    [
      "--output-format",
      "{output_format}"
    ]
  ],
  "params": [
    {
      "id": "scope",
      "label": "Scope",
      "description": "Which worksheets to freeze. 'All worksheets' (the default) converts every formula in the entire workbook. 'Active sheet only' limits the freeze to the one sheet currently active in Excel \u2014 useful when only one tab is final.",
      "type": "enum",
      "widget": "radio",
      "required": false,
      "default": "all_sheets",
      "choices": [
        "all_sheets",
        "active_sheet"
      ],
      "choice_labels": [
        "All worksheets",
        "Active sheet only"
      ]
    },
    {
      "id": "work_on_copy",
      "label": "Work on a copy (recommended)",
      "description": "SAFETY GUARD. When ticked (the default), the workbook is first copied to a sibling '<name>_Frozen.xlsx' and the freeze happens in that copy, which is then saved and closed \u2014 your original stays open with its live formulas intact. Untick to freeze the open workbook in memory instead; it is left open and UNSAVED for you to review. If the workbook has never been saved, copy mode is refused (there is no folder to put the copy in).",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true
    },
    {
      "id": "output_format",
      "label": "Output format",
      "description": "How the result summary is rendered in the output pane. 'Markdown' is easy to paste into notes; 'Plain text' is a simple aligned list.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "markdown",
      "choices": [
        "markdown",
        "text"
      ],
      "choice_labels": [
        "Markdown",
        "Plain text"
      ]
    }
  ],
  "source": {
    "mode": "manual",
    "help_text_cached": null
  },
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "category": "MSOffice/Excel"
}