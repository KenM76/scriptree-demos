{
  "schema_version": 3,
  "name": "Heading-Based Document Splitter (Word)",
  "description": "Splits the open Word document into one file per section, cutting at every paragraph set to the heading level you choose (Heading 1, 2, or 3). Each section is written to its own Word and/or PDF file, named after its heading with a zero-padded sequence prefix (e.g. '01_Introduction.docx', '02_Methods.docx'). Use it to break a long report, manual, or manuscript into per-chapter files for separate review, distribution, or printing.\n\nYour open document is NEVER modified. The tool only reads from it and creates new files in the output folder you pick (or, if you leave that blank, a '<DocName>_Chapters' folder created next to the original).\n\nSplitting is by OUTLINE LEVEL, so it works regardless of the language of your heading-style names and even catches paragraphs promoted to a heading outline level without the named style. Content before the first heading ('front matter' \u2014 a title page, abstract, table of contents) is saved as chapter '00' when the box below is ticked. Requires combridge (bundled with ScripTree at lib/combridge) and the target document already open in a running Word instance.",
  "executable": "python",
  "working_directory": ".",
  "argument_template": [
    "split_by_heading.py",
    [
      "--heading-level",
      "{heading_level}"
    ],
    [
      "--output-folder",
      "{output_folder}"
    ],
    [
      "--file-format",
      "{file_format}"
    ],
    "{include_front_matter?--include-front-matter}",
    [
      "--output-format",
      "{output_format}"
    ]
  ],
  "params": [
    {
      "id": "heading_level",
      "label": "Split at heading level",
      "description": "Which heading level marks the start of a new file. 'Heading 1' splits at top-level sections (typical for chapters); 'Heading 2' or 'Heading 3' split more finely (sub-sections). Matching is by outline level, so it is independent of your heading-style names and language, and also catches paragraphs given that outline level without the built-in style.",
      "type": "enum",
      "widget": "radio",
      "required": true,
      "default": "1",
      "choices": [
        "1",
        "2",
        "3"
      ],
      "choice_labels": [
        "Heading 1 (top-level chapters)",
        "Heading 2 (sub-sections)",
        "Heading 3 (finer sub-sections)"
      ],
      "section": "Split"
    },
    {
      "id": "output_folder",
      "label": "Output folder",
      "description": "Where to write the per-chapter files. Leave blank to create a '<DocName>_Chapters' folder next to the original document (that default requires the document to have been saved at least once). If you pick a folder that doesn't exist yet, it will be created.",
      "type": "path",
      "widget": "folder",
      "required": false,
      "default": "",
      "section": "Output"
    },
    {
      "id": "file_format",
      "label": "Output file format",
      "description": "What to write for each section. 'Word' produces .docx files (fully editable). 'PDF' produces .pdf files (fixed, for distribution/printing). 'Both' writes a .docx AND a .pdf for every section.",
      "type": "enum",
      "widget": "radio",
      "required": true,
      "default": "docx",
      "choices": [
        "docx",
        "pdf",
        "both"
      ],
      "choice_labels": [
        "Word (.docx)",
        "PDF (.pdf)",
        "Both Word and PDF"
      ],
      "section": "Output"
    },
    {
      "id": "include_front_matter",
      "label": "Save front matter as chapter 00",
      "description": "When ticked (default), any content BEFORE the first heading \u2014 a title page, abstract, or table of contents \u2014 is saved as its own file '00_Front-Matter'. Untick to discard that leading content and start the output at the first heading.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true,
      "section": "Split"
    },
    {
      "id": "output_format",
      "label": "Report format",
      "description": "How the result summary is rendered in the output pane. 'Markdown' is easy to paste into notes; 'Plain text' is a simple aligned list.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "markdown",
      "choices": [
        "markdown",
        "text"
      ],
      "choice_labels": [
        "Markdown",
        "Plain text"
      ],
      "section": "Output"
    }
  ],
  "sections": [
    {
      "name": "Split",
      "layout": "collapse"
    },
    {
      "name": "Output",
      "layout": "collapse"
    }
  ],
  "source": {
    "mode": "manual",
    "help_text_cached": null
  },
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "category": "MSOffice/Word"
}