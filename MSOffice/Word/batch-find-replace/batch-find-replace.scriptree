{
  "schema_version": 3,
  "name": "Batch Find & Replace (Word)",
  "description": "Finds every occurrence of a phrase in the open Word document and replaces it in one pass, then reports exactly how many replacements were made. Faster and more auditable than Word's built-in dialog when you just want a clean count and a safe copy.\n\nBy default it works on a COPY: the document is saved alongside the original as '<name>_Replacements.docx' and all edits land there, leaving your original file untouched. Untick 'Work on a copy' to edit the open document directly (the edits stay unsaved in Word so you can review them before saving).\n\nSupports match-case, whole-word, and Word wildcard matching. Requires combridge (bundled with ScripTree at lib/combridge) and the target document already open in a running Word instance.",
  "executable": "python",
  "working_directory": ".",
  "argument_template": [
    "word_find_replace.py",
    [
      "--find",
      "{find_text}"
    ],
    [
      "--replace",
      "{replace_text}"
    ],
    "{match_case?--match-case}",
    "{whole_word?--whole-word}",
    "{use_wildcards?--use-wildcards}",
    "{work_on_copy?--work-on-copy}",
    [
      "--output-format",
      "{output_format}"
    ]
  ],
  "params": [
    {
      "id": "find_text",
      "label": "Find what",
      "description": "The text to search for. Required. With 'Use wildcards' on, this is a Word wildcard pattern (e.g. '<colou?r>' style expressions) rather than a literal phrase.",
      "type": "string",
      "widget": "text",
      "required": true,
      "default": "",
      "no_split": true,
      "section": "Find & replace"
    },
    {
      "id": "replace_text",
      "label": "Replace with",
      "description": "The replacement text. Leave this blank to DELETE every occurrence of the 'Find what' text.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "no_split": true,
      "section": "Find & replace"
    },
    {
      "id": "match_case",
      "label": "Match case",
      "description": "When ticked, 'Report' matches 'Report' but not 'report'. When unticked, matching ignores case.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Matching"
    },
    {
      "id": "whole_word",
      "label": "Whole words only",
      "description": "When ticked, only complete words match \u2014 searching 'cat' will not match the 'cat' inside 'category'.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Matching"
    },
    {
      "id": "use_wildcards",
      "label": "Use wildcards",
      "description": "Treat 'Find what' as a Word wildcard pattern instead of literal text (the same engine as Word's 'Use wildcards' checkbox). Leave off for ordinary phrase replacement.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Matching"
    },
    {
      "id": "work_on_copy",
      "label": "Work on a copy (recommended)",
      "description": "SAFETY GUARD. When ticked (the default), the document is first saved as '<name>_Replacements.docx' in the same folder and all edits are made to that copy \u2014 your original file is never modified. Untick to edit the open document in place; in that case the edits are left UNSAVED in Word so you can review and save them yourself.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true,
      "section": "Output & safety"
    },
    {
      "id": "output_format",
      "label": "Output format",
      "description": "How the result summary is rendered in the output pane. 'Markdown' is easy to paste into notes; 'Plain text' is a simple aligned list.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "markdown",
      "choices": [
        "markdown",
        "text"
      ],
      "choice_labels": [
        "Markdown",
        "Plain text"
      ],
      "section": "Output & safety"
    }
  ],
  "sections": [
    {
      "name": "Find & replace",
      "layout": "collapse"
    },
    {
      "name": "Matching",
      "layout": "collapse"
    },
    {
      "name": "Output & safety",
      "layout": "collapse"
    }
  ],
  "source": {
    "mode": "manual",
    "help_text_cached": null
  },
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "category": "MSOffice/Word"
}