// attachment_extractor.csx — generated by attachment_extractor.py (Strategy A shim).
// Do not edit the generated copy; edit attachment_extractor.csx.template instead, and
// remember every __PLACEHOLDER__ token below is replaced by the shim before this runs.
//
// Runs inside combridge's Outlook plugin via `run-script`. Globals available:
//   olApp      (Ol._Application, never null)
//   olNs       (Ol.NameSpace,   the MAPI namespace)
//   olExplorer (Ol.Explorer?,   the active explorer — MAY BE NULL if no window is open)
// Default usings injected by combridge include System, System.Collections.Generic,
// System.Linq, System.Runtime.InteropServices, Microsoft.Office.Interop.Outlook.
// We add System.IO explicitly for Directory/Path/File (not in the default set).
//
// THE SAFETY CONTRACT (why this tool is "surgical"):
//   The ONLY mutating call anywhere in this script is Attachment.SaveAsFile, which
//   copies the attachment's bytes to a NEW file on disk. We never call
//   Attachment.Delete, never set any property on a MailItem, never call .Save() /
//   .Move() / .Delete() on an item. The mailbox is read-only; only the output
//   folder on disk gains new files.
//
// combridge swallows the script's return value (always exits 0 on a clean run), so
// this script signals state to the shim with a first-line sentinel; the shim owns
// the real process exit code:
//   __OLXTRACT__ STATUS=NOEXPLORER              -> shim exits 2 (no explorer/folder)
//   __OLXTRACT__ STATUS=NOSEL                   -> shim exits 2 (selection mode, nothing selected)
//   __OLXTRACT__ STATUS=NOOUTDIR                -> shim exits 2 (output dir uncreatable)
//   __OLXTRACT__ STATUS=OK saved=N scanned=M    -> shim exits 0 (ran; N may be 0)
// The shim strips the sentinel line before showing the report. An empty source
// folder is NOT an error — it's STATUS=OK with saved=0.

using System.IO;

// --- values baked in by the shim ---
string scope         = "__SCOPE__";          // "selection" | "folder"
string outDir        = "__OUTPUT_FOLDER__";   // directory to save into (created if missing)
string extSpec       = "__EXTENSIONS__";      // comma/space separated allow-list, "" = all
bool   includeInline = __INCLUDE_INLINE__;    // also save inline/embedded images (signature logos)
string clashPolicy   = "__ON_NAME_CLASH__";   // "rename" | "skip" | "overwrite"
string outputFormat  = "__OUTPUT_FORMAT__";   // "markdown" | "text"

// PR_ATTACH_CONTENT_ID — present on attachments that are referenced inline from
// the HTML body (signature logos, embedded images). We use its presence as the
// "is inline" signal, since OlAttachmentType alone does not distinguish a real
// file attachment from an embedded body image (both are olByValue).
const string PR_ATTACH_CONTENT_ID =
    "http://schemas.microsoft.com/mapi/proptag/0x3712001F";

// --- parse the extension allow-list into a case-insensitive, dot-less set ---
// "pdf, .DOCX  xlsx" -> { pdf, docx, xlsx }. Empty set => no extension filter.
var allow = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
foreach (var tok in extSpec.Split(
             new[] { ',', ';', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries))
{
    string e = tok.TrimStart('.').Trim();
    if (e.Length > 0) allow.Add(e);
}
bool filterExt = allow.Count > 0;

// --- STEP 1: resolve the set of items to process ---------------------------
// olExplorer is the active Outlook window. Without it we can read neither the
// selection nor the current folder, so we cannot do anything.
if (olExplorer == null)
{
    Console.WriteLine("__OLXTRACT__ STATUS=NOEXPLORER");
    Console.WriteLine("No active Outlook explorer window was found. Open Outlook "
        + "(with a mailbox folder showing) and try again.");
    return 0;
}

var items = new List<object>();
string scopeDesc;

if (scope == "selection")
{
    Selection sel = null;
    try { sel = olExplorer.Selection; } catch { }
    if (sel == null || sel.Count == 0)
    {
        Console.WriteLine("__OLXTRACT__ STATUS=NOSEL");
        Console.WriteLine("You chose 'Selected emails' but nothing is selected in "
            + "Outlook. Select one or more messages and run again (or switch the "
            + "scope to 'Current folder').");
        return 0;
    }
    foreach (object it in sel) items.Add(it);
    scopeDesc = $"{items.Count} selected item(s)";
}
else
{
    Folder cur = null;
    try { cur = (Folder)olExplorer.CurrentFolder; } catch { }
    if (cur == null)
    {
        Console.WriteLine("__OLXTRACT__ STATUS=NOEXPLORER");
        Console.WriteLine("Could not determine the current Outlook folder. Open a "
            + "mail folder and try again.");
        return 0;
    }
    // NOTE: 'folder' scope necessarily iterates every item — there is no
    // lightweight MAPI table that can SAVE attachment bytes, so we must touch
    // each item. This can be slow on very large folders; 'selection' scope is
    // the fast, surgical path.
    string folderName = "";
    try { folderName = cur.Name; } catch { }
    try
    {
        foreach (object it in cur.Items) items.Add(it);
    }
    catch { }
    scopeDesc = $"folder '{folderName}' ({items.Count} item(s))";
}

// --- STEP 2: ensure the output directory exists ----------------------------
try { Directory.CreateDirectory(outDir); }
catch
{
    Console.WriteLine("__OLXTRACT__ STATUS=NOOUTDIR");
    Console.WriteLine($"Could not create or access the output folder:\n  {outDir}\n"
        + "Check the path and your permissions, then try again.");
    return 0;
}

// --- STEP 3: helpers for filename sanitising + clash policy ----------------
char[] invalid = Path.GetInvalidFileNameChars();

string Sanitize(string name)
{
    var sb = new System.Text.StringBuilder(name.Length);
    foreach (char c in name) sb.Append(Array.IndexOf(invalid, c) >= 0 ? '_' : c);
    string s = sb.ToString().Trim();
    return s.Length == 0 ? "attachment" : s;
}

// Names already on disk OR already written this run. Honours the clash policy:
//   overwrite -> always return the base name (later file replaces earlier).
//   skip      -> return null when the name is taken (caller counts a skip).
//   rename    -> append " (n)" until unique, reserve it.
var used = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
try { foreach (var f in Directory.GetFiles(outDir)) used.Add(Path.GetFileName(f)); }
catch { }

string ReserveName(string fileName)
{
    if (clashPolicy == "overwrite") return fileName;
    if (!used.Contains(fileName)) { used.Add(fileName); return fileName; }
    if (clashPolicy == "skip") return null;
    string stem = Path.GetFileNameWithoutExtension(fileName);
    string ext  = Path.GetExtension(fileName);
    for (int n = 1; n < 100000; n++)
    {
        string cand = $"{stem} ({n}){ext}";
        if (!used.Contains(cand)) { used.Add(cand); return cand; }
    }
    return null;
}

// --- STEP 4: walk items, save matching attachments -------------------------
int saved = 0, skippedFilter = 0, skippedInline = 0, skippedClash = 0, saveErrors = 0;
int emailsScanned = 0, emailsWithSaves = 0;
long savedBytes = 0;
var rows = new List<(string file, string from, long bytes)>();  // capped report rows

foreach (object itObj in items)
{
    emailsScanned++;
    dynamic it = itObj;

    string fromAddr = "";
    try { fromAddr = (string)it.SenderName; } catch { }
    if (string.IsNullOrEmpty(fromAddr))
    {
        try { fromAddr = (string)it.SenderEmailAddress; } catch { }
    }

    Attachments atts = null;
    try { atts = it.Attachments; } catch { }
    if (atts == null) continue;

    bool anySaved = false;
    foreach (Attachment att in atts)
    {
        string fn = "";
        try { fn = att.FileName; } catch { }
        if (string.IsNullOrEmpty(fn)) continue;

        // inline / embedded-image check (signature logos etc.)
        bool isInline = false;
        try
        {
            object cid = att.PropertyAccessor.GetProperty(PR_ATTACH_CONTENT_ID);
            if (cid != null && cid.ToString().Length > 0) isInline = true;
        }
        catch { /* property absent => not inline */ }
        if (isInline && !includeInline) { skippedInline++; continue; }

        // extension allow-list
        if (filterExt)
        {
            string ext = Path.GetExtension(fn).TrimStart('.');
            if (!allow.Contains(ext)) { skippedFilter++; continue; }
        }

        string finalName = ReserveName(Sanitize(fn));
        if (finalName == null) { skippedClash++; continue; }   // skip policy, name taken

        string full = Path.Combine(outDir, finalName);
        try
        {
            att.SaveAsFile(full);            // <-- the ONLY mutating call (writes a file)
            saved++; anySaved = true;
            long sz = 0; try { sz = att.Size; } catch { }
            savedBytes += sz;
            if (rows.Count < 200) rows.Add((finalName, fromAddr, sz));
        }
        catch
        {
            saveErrors++;
        }
    }
    if (anySaved) emailsWithSaves++;
}

// --- STEP 5: report --------------------------------------------------------
string FmtSize(long b)
{
    double mb = b / 1048576.0;
    if (mb >= 1024.0) return $"{mb / 1024.0:0.00} GB";
    if (mb >= 1.0)    return $"{mb:0.0} MB";
    return $"{b / 1024.0:0} KB";
}

Console.WriteLine($"__OLXTRACT__ STATUS=OK saved={saved} scanned={emailsScanned}");

string filterDesc = filterExt
    ? string.Join(", ", allow.OrderBy(x => x))
    : "all attachments";
var skipBits = new List<string>();
if (skippedInline > 0) skipBits.Add($"{skippedInline} inline image(s)");
if (skippedFilter > 0) skipBits.Add($"{skippedFilter} non-matching");
if (skippedClash  > 0) skipBits.Add($"{skippedClash} name-clash skip(s)");
if (saveErrors    > 0) skipBits.Add($"{saveErrors} save error(s)");
string skipDesc = skipBits.Count > 0 ? string.Join(", ", skipBits) : "none";

if (outputFormat == "markdown")
{
    Console.WriteLine("# Attachment extraction");
    Console.WriteLine();
    Console.WriteLine($"- **Scope:** {scopeDesc}");
    Console.WriteLine($"- **Output folder:** `{outDir}`");
    Console.WriteLine($"- **Filter:** {filterDesc}");
    Console.WriteLine($"- **Inline images:** {(includeInline ? "included" : "skipped")}");
    Console.WriteLine($"- **Name clashes:** {clashPolicy}");
    Console.WriteLine($"- **Saved:** {saved} attachment(s) ({FmtSize(savedBytes)}) "
        + $"from {emailsWithSaves} of {emailsScanned} email(s)");
    Console.WriteLine($"- **Skipped:** {skipDesc}");
    Console.WriteLine();
    if (rows.Count > 0)
    {
        Console.WriteLine("| Saved file | From | Size |");
        Console.WriteLine("|---|---|--:|");
        foreach (var r in rows)
        {
            string file = r.file.Replace("|", "\\|");
            string from = (r.from ?? "").Replace("|", "\\|");
            Console.WriteLine($"| {file} | {from} | {FmtSize(r.bytes)} |");
        }
        if (saved > rows.Count)
            Console.WriteLine($"\n_(+{saved - rows.Count} more not listed)_");
    }
    else
    {
        Console.WriteLine("_No attachments matched — nothing was saved._");
    }
    Console.WriteLine();
    Console.WriteLine("_The emails were not modified. Only new files were written "
        + "to the output folder._");
}
else
{
    string title = "Attachment extraction";
    Console.WriteLine(title);
    Console.WriteLine(new string('=', title.Length));
    Console.WriteLine($"Scope        : {scopeDesc}");
    Console.WriteLine($"Output folder: {outDir}");
    Console.WriteLine($"Filter       : {filterDesc}");
    Console.WriteLine($"Inline images: {(includeInline ? "included" : "skipped")}");
    Console.WriteLine($"Name clashes : {clashPolicy}");
    Console.WriteLine($"Saved        : {saved} attachment(s) ({FmtSize(savedBytes)}) "
        + $"from {emailsWithSaves} of {emailsScanned} email(s)");
    Console.WriteLine($"Skipped      : {skipDesc}");
    Console.WriteLine();
    foreach (var r in rows)
        Console.WriteLine($"{FmtSize(r.bytes),9}  {r.file}   <- {r.from}");
    if (saved > rows.Count)
        Console.WriteLine($"(+{saved - rows.Count} more not listed)");
    Console.WriteLine();
    Console.WriteLine("The emails were not modified. Only new files were written "
        + "to the output folder.");
}

return 0;
