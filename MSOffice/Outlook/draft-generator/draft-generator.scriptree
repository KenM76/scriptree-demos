{
  "schema_version": 3,
  "name": "Draft Generator from Template (Outlook)",
  "description": "Turns an Excel mailing list into one DRAFT Outlook email per row \u2014 a mail merge that STOPS at drafts for human review. Give it an .xlsx whose first row is column headers (Email, Name, Company, ...), plus a subject and body template containing {ColumnName} placeholders. For each data row it creates a personalised draft in your Outlook Drafts folder, substituting each {Header} token with that row's value.\n\nSAFETY \u2014 this tool CREATES DRAFTS ONLY and NEVER SENDS. Every generated message is an unsent draft you review and send yourself. It also enforces a hard cap of 50 drafts per run, so a bad merge can never blast a list. Rows with a blank recipient cell are skipped.\n\nThe Excel is read by the tool's Python helper (openpyxl) \u2014 Excel itself need not be installed or open; only Outlook must be running. Requires combridge (bundled with ScripTree at lib/combridge).",
  "executable": "python",
  "working_directory": ".",
  "argument_template": [
    "generate_drafts.py",
    [
      "--mailing-list",
      "{mailing_list}"
    ],
    [
      "--email-column",
      "{email_column}"
    ],
    [
      "--subject-template",
      "{subject_template}"
    ],
    [
      "--body-template",
      "{body_template}"
    ],
    [
      "--max-drafts",
      "{max_drafts}"
    ],
    [
      "--output-format",
      "{output_format}"
    ]
  ],
  "params": [
    {
      "id": "mailing_list",
      "label": "Mailing list (.xlsx)",
      "description": "The Excel workbook holding your recipients. Row 1 must be column headers (e.g. Email, Name, Company); each row below is one recipient. The active sheet is used. Required.",
      "type": "path",
      "widget": "file",
      "required": true,
      "default": "",
      "no_split": true,
      "file_filter": "Excel workbooks (*.xlsx);;All files (*)",
      "section": "Mailing list"
    },
    {
      "id": "email_column",
      "label": "Recipient column header",
      "description": "The exact header text of the column that holds the recipient email addresses. Matched case-insensitively. Default 'Email'. If no header matches, the run is refused.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "Email",
      "no_split": true,
      "section": "Mailing list"
    },
    {
      "id": "subject_template",
      "label": "Subject template",
      "description": "The subject line for every draft. May contain {ColumnName} placeholders that are replaced per row, e.g. 'Your Q3 statement, {Name}'. Tokens are the brace-wrapped exact header text (case-sensitive).",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "no_split": true,
      "section": "Message"
    },
    {
      "id": "body_template",
      "label": "Body template",
      "description": "The message body for every draft (multi-line). Use {ColumnName} placeholders to merge per-row values, e.g. 'Dear {Name},\\n\\nYour statement from {Company} is ready.'. Tokens are the brace-wrapped exact header text (case-sensitive); unknown braces are left as-is. Required.",
      "type": "string",
      "widget": "textarea",
      "required": true,
      "default": "",
      "no_split": true,
      "section": "Message"
    },
    {
      "id": "max_drafts",
      "label": "Maximum drafts (cap 50)",
      "description": "The most drafts to create in one run. Hard-capped at 50 (the absolute maximum) and floored at 1 \u2014 a safety limit so a mistaken merge can't generate a huge batch even as drafts. If the list has more usable rows than this, only the first N are drafted.",
      "type": "integer",
      "widget": "number",
      "required": false,
      "default": 50,
      "section": "Options"
    },
    {
      "id": "output_format",
      "label": "Output format",
      "description": "How the result summary is rendered in the output pane. 'Markdown' is easy to paste into notes; 'Plain text' is a simple aligned list.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "markdown",
      "choices": [
        "markdown",
        "text"
      ],
      "choice_labels": [
        "Markdown",
        "Plain text"
      ],
      "section": "Options"
    }
  ],
  "sections": [
    {
      "name": "Mailing list",
      "layout": "collapse"
    },
    {
      "name": "Message",
      "layout": "collapse"
    },
    {
      "name": "Options",
      "layout": "collapse"
    }
  ],
  "source": {
    "mode": "manual",
    "help_text_cached": null
  },
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "category": "MSOffice/Outlook"
}