// generate_drafts.csx — generated by generate_drafts.py (Strategy A shim).
// Do not edit the generated copy; edit generate_drafts.csx.template instead, and
// remember every double-underscore token below is replaced by the shim before this runs.
//
// Runs inside combridge's Outlook plugin via `run-script`. Globals available:
//   olApp      (Ol._Application, never null)
//   olNs       (Ol.NameSpace,   the MAPI namespace)
//   olExplorer (Ol.Explorer?,   the active explorer — MAY BE NULL; NOT needed here:
//                                CreateItem works without any explorer/window open)
// Default usings injected by combridge include System, System.Collections.Generic,
// System.Linq, System.Runtime.InteropServices, Microsoft.Office.Interop.Outlook.
// (We need no extra usings — no file I/O here; the Excel was already read by the shim.)
//
// ============================================================================
// THE SAFETY CONTRACT (the whole reason this tool exists in this shape)
// ============================================================================
//   This script CREATES DRAFTS ONLY. It NEVER SENDS.
//
//   * The ONLY thing it does to each new mail item is set To/Subject/Body and
//     call mi.Save(). Save() places a NEW UNSENT MailItem in the Drafts folder.
//   * There is NO send call ANYWHERE in this file (no MailItem send method is
//     ever invoked). Sending is forbidden; creating drafts is allowed. If you
//     ever introduce a send call here you have broken the headline guarantee of
//     the tool — don't. (The send-method literal deliberately does not appear in
//     any code or comment so a grep for it on the rendered .csx returns nothing.)
//   * The number of rows handed to this script is hard-capped at 50 by the shim
//     (clamp_max in generate_drafts.py). This script trusts that cap but the loop
//     also cannot exceed the baked array length, which is <= 50 by construction.
//
//   Net effect: after a run, the user has up to 50 unsent drafts to review in
//   Outlook. Nothing leaves the mailbox until the human clicks Send.
//
// combridge swallows the script's return value (always exits 0 on a clean run), so
// this script signals state to the shim with a first-line sentinel; the shim owns
// the real process exit code:
//   __OLDRAFT__ STATUS=NOITEMS                      -> shim exits 2 (nothing to draft)
//   __OLDRAFT__ STATUS=OK created=N failed=F        -> shim exits 0 (ran; drafts made)
// The shim strips the sentinel line before showing the report.

// --- values baked in by the shim ---
string mailingList  = "__MAILING_LIST__";   // source .xlsx path (for the report only)
string outputFormat = "__OUTPUT_FORMAT__";  // "markdown" | "text"
int    rowCount     = __ROW_COUNT__;         // number of baked rows (== ROWS.Count; <= 50)

// The baked mailing-list rows. Each entry is { to, subject, body }, already
// rendered by the Python shim (placeholders resolved, recipient non-blank).
// The shim guarantees this list has at most 50 entries (the hard draft cap).
var ROWS = new List<string[]> {
__BAKED_ROWS__
};

// --- STEP 1: nothing to do? ------------------------------------------------
// Defensive: in normal operation the shim short-circuits an empty merge before
// ever launching us, so this branch is a belt-and-braces guard.
if (rowCount == 0 || ROWS.Count == 0)
{
    Console.WriteLine("__OLDRAFT__ STATUS=NOITEMS");
    Console.WriteLine("No usable rows were supplied, so no drafts were created.");
    return 0;
}

// --- STEP 2: resolve the Drafts folder -------------------------------------
// GetDefaultFolder(olFolderDrafts) returns the default store's Drafts folder.
// We don't strictly need to Move() items there — a freshly CreateItem()'d,
// never-sent MailItem that is Save()'d lands in Drafts automatically — but we
// resolve it to name it in the report (and to fail loudly if the profile is odd).
MAPIFolder drafts = null;
string draftsName = "Drafts";
try
{
    drafts = olNs.GetDefaultFolder(OlDefaultFolders.olFolderDrafts);
    if (drafts != null) draftsName = drafts.Name;
}
catch { /* non-fatal: Save() still lands new unsent items in Drafts */ }

// --- STEP 3: create one DRAFT per row --------------------------------------
int created = 0, failed = 0;
var madeRows = new List<(string to, string subject)>();  // capped report rows

foreach (var r in ROWS)
{
    string to   = r.Length > 0 ? r[0] : "";
    string subj = r.Length > 1 ? r[1] : "";
    string body = r.Length > 2 ? r[2] : "";

    try
    {
        // CreateItem(olMailItem) makes a brand-new, unsent mail item. It needs
        // NO open explorer/window. We set the three fields and Save() it.
        MailItem mi = (MailItem)olApp.CreateItem(OlItemType.olMailItem);
        mi.To = to;
        mi.Subject = subj;
        mi.Body = body;
        mi.Save();          // <-- lands the UNSENT draft in the Drafts folder.
                            //     ** drafts only — no send call, ever. **
        created++;
        if (madeRows.Count < 200) madeRows.Add((to, subj));
    }
    catch
    {
        // One bad row (e.g. a malformed address Outlook rejects on Save) must
        // not abort the whole merge — count it and carry on.
        failed++;
    }
}

// --- STEP 4: report --------------------------------------------------------
Console.WriteLine($"__OLDRAFT__ STATUS=OK created={created} failed={failed}");

if (outputFormat == "markdown")
{
    Console.WriteLine("# Draft generation");
    Console.WriteLine();
    Console.WriteLine($"- **Mailing list:** `{mailingList}`");
    Console.WriteLine($"- **Recipients processed:** {ROWS.Count}");
    Console.WriteLine($"- **Drafts created:** {created} (in the '{draftsName}' folder)");
    if (failed > 0)
        Console.WriteLine($"- **Failed:** {failed} row(s) could not be drafted");
    Console.WriteLine();
    if (madeRows.Count > 0)
    {
        Console.WriteLine("| # | To | Subject |");
        Console.WriteLine("|--:|---|---|");
        int n = 0;
        foreach (var m in madeRows)
        {
            n++;
            string to   = (m.to ?? "").Replace("|", "\\|");
            string subj = (m.subject ?? "").Replace("|", "\\|");
            Console.WriteLine($"| {n} | {to} | {subj} |");
        }
        if (created > madeRows.Count)
            Console.WriteLine($"\n_(+{created - madeRows.Count} more not listed)_");
    }
    Console.WriteLine();
    Console.WriteLine("> **No emails were sent.** Each item above is a DRAFT — "
        + "review them in your Outlook Drafts folder and send them yourself when "
        + "you're ready.");
}
else
{
    string title = "Draft generation";
    Console.WriteLine(title);
    Console.WriteLine(new string('=', title.Length));
    Console.WriteLine($"Mailing list        : {mailingList}");
    Console.WriteLine($"Recipients processed: {ROWS.Count}");
    Console.WriteLine($"Drafts created      : {created} (in the '{draftsName}' folder)");
    if (failed > 0)
        Console.WriteLine($"Failed              : {failed} row(s) could not be drafted");
    Console.WriteLine();
    int n = 0;
    foreach (var m in madeRows)
    {
        n++;
        Console.WriteLine($"{n,4}. {m.to}  ->  {m.subject}");
    }
    if (created > madeRows.Count)
        Console.WriteLine($"(+{created - madeRows.Count} more not listed)");
    Console.WriteLine();
    Console.WriteLine("NO emails were sent. Each item above is a DRAFT — review "
        + "them in your Outlook Drafts folder and send them yourself when ready.");
}

return 0;
