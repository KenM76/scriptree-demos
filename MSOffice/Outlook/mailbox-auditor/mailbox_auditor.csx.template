// mailbox_auditor.csx — generated by mailbox_auditor.py (Strategy A shim).
// Do not edit the generated copy; edit mailbox_auditor.csx.template instead.
//
// Runs inside combridge's Outlook plugin via `run-script`. Globals available:
//   olApp      (Ol._Application, never null)
//   olNs       (Ol.NameSpace,   the MAPI namespace)
//   olExplorer (Ol.Explorer?,   active explorer — not used here)
// Default usings injected by combridge include System, System.Collections.Generic,
// System.Linq, System.Runtime.InteropServices, Microsoft.Office.Interop.Outlook.
//
// combridge swallows the script's return value (always exits 0 on a clean run),
// so this script signals state to the shim with a first-line sentinel:
//   __MAILAGE__ STATUS=NO_STORE                 -> shim exits 2, shows the message
//   __MAILAGE__ STATUS=OK folders=N stores=S    -> shim exits 0
// The shim strips the sentinel line before showing the report.
//
// PERFORMANCE: we never touch a MailItem in a loop (that freezes Outlook on big
// folders). Per folder we ask MAPI for a lightweight Table of just two columns —
// PR_MESSAGE_SIZE and ReceivedTime — and sum the rows. That stays fast even on
// 40k-item folders. Some system/search folders throw on GetTable(); we catch and
// skip those so one stubborn folder can't abort the whole traversal.

// --- values baked in by the shim ---
string scope        = "__SCOPE__";          // "all" | "default"
int staleYears      = __STALE_YEARS__;       // dead-weight age threshold (years)
int minFolderMb     = __MIN_FOLDER_MB__;     // hide folders below this size
string outputFormat = "__OUTPUT_FORMAT__";   // "markdown" | "text"

const string PR_MESSAGE_SIZE = "http://schemas.microsoft.com/mapi/proptag/0x0E080003";

DateTime cutoff = DateTime.Now.AddYears(-staleYears);
long minBytes = (long)minFolderMb * 1048576L;

// Choose the stores to audit.
var stores = new List<Store>();
if (scope == "default")
{
    Store ds = null;
    try { ds = olNs.DefaultStore; } catch { }
    if (ds != null) stores.Add(ds);
}
else
{
    foreach (Store s in olNs.Stores) stores.Add(s);
}

if (stores.Count == 0)
{
    Console.WriteLine("__MAILAGE__ STATUS=NO_STORE");
    Console.WriteLine("No Outlook stores were found. Make sure Outlook is running with a mailbox loaded, then run again.");
    return 0;
}

// One row per folder.
var recs = new List<(string path, int count, long bytes, DateTime oldest,
                     DateTime newest, bool hasDates, int staleCount, long staleBytes)>();

void Walk(Folder folder, string path)
{
    int count = 0;
    long bytes = 0;
    DateTime oldest = DateTime.MaxValue, newest = DateTime.MinValue;
    bool hasDates = false;
    int staleCount = 0;
    long staleBytes = 0;

    try
    {
        Table table = folder.GetTable("", OlTableContents.olUserItems);
        table.Columns.RemoveAll();
        table.Columns.Add(PR_MESSAGE_SIZE);
        table.Columns.Add("ReceivedTime");
        while (!table.EndOfTable)
        {
            Row row = table.GetNextRow();
            long size = 0;
            object szObj = row[1];
            if (szObj != null) { try { size = Convert.ToInt64(szObj); } catch { } }
            count++;
            bytes += size;
            object rtObj = row[2];
            if (rtObj is DateTime dt)
            {
                hasDates = true;
                if (dt < oldest) oldest = dt;
                if (dt > newest) newest = dt;
                if (dt < cutoff) { staleCount++; staleBytes += size; }
            }
        }
        recs.Add((path, count, bytes, oldest, newest, hasDates, staleCount, staleBytes));
    }
    catch
    {
        // Search folders / certain system folders reject GetTable — skip this
        // folder's own stats but still descend into its children below.
    }

    try
    {
        foreach (Folder sub in folder.Folders)
            Walk(sub, path + "\\" + sub.Name);
    }
    catch { }
}

foreach (Store store in stores)
{
    Folder root = null;
    try { root = (Folder)store.GetRootFolder(); } catch { }
    if (root == null) continue;
    string storeName = "";
    try { storeName = store.DisplayName; } catch { }
    if (string.IsNullOrEmpty(storeName)) storeName = root.Name;
    Walk(root, storeName);
}

string FmtSize(long b)
{
    double mb = b / 1048576.0;
    if (mb >= 1024.0) return $"{mb / 1024.0:0.00} GB";
    if (mb >= 1.0)    return $"{mb:0.0} MB";
    return $"{b / 1024.0:0} KB";
}

// Grand totals across everything we audited (before the display filter).
long grandBytes = 0, grandStaleBytes = 0;
int grandCount = 0, grandStaleCount = 0;
foreach (var r in recs)
{
    grandBytes += r.bytes; grandCount += r.count;
    grandStaleBytes += r.staleBytes; grandStaleCount += r.staleCount;
}

// Folders to show: at or above the size floor, largest first.
var shown = recs.Where(r => r.bytes >= minBytes)
                .OrderByDescending(r => r.bytes)
                .ToList();
int hidden = recs.Count - shown.Count;

Console.WriteLine($"__MAILAGE__ STATUS=OK folders={shown.Count} stores={stores.Count}");

string yearWord = staleYears == 1 ? "year" : "years";
string staleHdr = $"Older than {staleYears} {yearWord}";

string summary =
    $"Audited {stores.Count} store{(stores.Count == 1 ? "" : "s")}, "
    + $"{recs.Count} folder{(recs.Count == 1 ? "" : "s")} "
    + $"({grandCount:n0} items, {FmtSize(grandBytes)} total). "
    + $"Older than {staleYears} {yearWord}: {grandStaleCount:n0} items, {FmtSize(grandStaleBytes)}."
    + (hidden > 0 ? $" {hidden} folder{(hidden == 1 ? "" : "s")} below {minFolderMb} MB hidden." : "");

if (recs.Count == 0)
{
    Console.WriteLine(outputFormat == "markdown"
        ? "**No folders found in the selected scope.** The mailbox appears to be empty."
        : "No folders found in the selected scope. The mailbox appears to be empty.");
    return 0;
}

if (shown.Count == 0)
{
    Console.WriteLine(outputFormat == "markdown"
        ? $"**No folders are {minFolderMb} MB or larger.** ({summary})"
        : $"No folders are {minFolderMb} MB or larger. ({summary})");
    return 0;
}

string AgeSpan((string path, int count, long bytes, DateTime oldest, DateTime newest,
                bool hasDates, int staleCount, long staleBytes) r)
    => r.hasDates ? $"{r.oldest:yyyy-MM} → {r.newest:yyyy-MM}" : "—";

if (outputFormat == "markdown")
{
    Console.WriteLine("# Mailbox age & size audit");
    Console.WriteLine();
    Console.WriteLine($"| Folder | Items | Size | Age span | {staleHdr} |");
    Console.WriteLine("|---|--:|--:|---|---|");
    foreach (var r in shown)
    {
        string folderCell = r.path.Replace("|", "\\|");
        string staleCell = r.staleCount > 0 ? $"{r.staleCount:n0} ({FmtSize(r.staleBytes)})" : "—";
        Console.WriteLine($"| {folderCell} | {r.count:n0} | {FmtSize(r.bytes)} | {AgeSpan(r)} | {staleCell} |");
    }
    Console.WriteLine();
    Console.WriteLine($"**Summary:** {summary}");
}
else
{
    string title = "Mailbox age & size audit";
    Console.WriteLine(title);
    Console.WriteLine(new string('=', title.Length));
    foreach (var r in shown)
    {
        string staleCell = r.staleCount > 0 ? $"{r.staleCount:n0} / {FmtSize(r.staleBytes)}" : "none";
        Console.WriteLine(
            $"{FmtSize(r.bytes),10}  {r.count,7:n0} items  [{AgeSpan(r)}]  stale: {staleCell}");
        Console.WriteLine($"            {r.path}");
    }
    Console.WriteLine();
    Console.WriteLine("Summary: " + summary);
}

return 0;
