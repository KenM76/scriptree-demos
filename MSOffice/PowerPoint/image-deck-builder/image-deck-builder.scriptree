{
  "schema_version": 3,
  "name": "Image-to-Slide Deck Builder (PowerPoint)",
  "description": "Builds a BRAND-NEW PowerPoint deck from a folder of images \u2014 one image per slide, each scaled to fit the slide and centered. Point it at a folder of photos, screenshots, or scanned pages and it assembles a ready-to-review slideshow in seconds.\n\nThis tool only CREATES output; it never modifies an existing presentation. The new deck is saved to the output file you name (blank means 'Slideshow.pptx' in the image folder), opened in a window so you can review it immediately, and left open and unsaved-over so nothing is overwritten without you choosing to.\n\nThe image folder is scanned NON-recursively (the chosen folder only, not sub-folders) for files ending in .jpg .jpeg .png .gif .bmp .tif .tiff (case-insensitive), and the slides are built in filename order. Tick 'Add filename captions' to label each slide with the image's filename (without its extension). Requires combridge (bundled with ScripTree at lib/combridge) and a running PowerPoint instance to build the deck into.",
  "executable": "python",
  "working_directory": ".",
  "argument_template": [
    "build_image_deck.py",
    [
      "--source-folder",
      "{source_folder}"
    ],
    [
      "--output-file",
      "{output_file}"
    ],
    "{add_captions?--add-captions}",
    [
      "--output-format",
      "{output_format}"
    ]
  ],
  "params": [
    {
      "id": "source_folder",
      "label": "Image folder",
      "description": "The folder of images to turn into a deck. It is scanned NON-recursively (only this folder, not its sub-folders) for files ending in .jpg, .jpeg, .png, .gif, .bmp, .tif, or .tiff (case-insensitive). The images are added in filename order, one per slide.",
      "type": "path",
      "widget": "folder",
      "required": true,
      "default": "",
      "no_split": true
    },
    {
      "id": "output_file",
      "label": "Output file",
      "description": "Where to save the new deck. Leave blank to save 'Slideshow.pptx' inside the image folder. If you type a bare file name (no folder), it is saved inside the image folder; type a full path to save it elsewhere. If a file of that name already exists it is NOT overwritten \u2014 a ' (2)', ' (3)', \u2026 suffix is added so your earlier deck is preserved.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "no_split": true
    },
    {
      "id": "add_captions",
      "label": "Add filename captions",
      "description": "Add the image's filename (without its extension) as a caption in a text box across the bottom of each slide. Useful when the filenames are meaningful (page numbers, product codes, dates). Off by default \u2014 a clean image-only slideshow.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false
    },
    {
      "id": "output_format",
      "label": "Output format",
      "description": "How the result summary is rendered in the output pane. 'Markdown' is easy to paste into notes; 'Plain text' is a simple aligned list.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "markdown",
      "choices": [
        "markdown",
        "text"
      ],
      "choice_labels": [
        "Markdown",
        "Plain text"
      ]
    }
  ],
  "source": {
    "mode": "manual",
    "help_text_cached": null
  },
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "category": "MSOffice/PowerPoint"
}