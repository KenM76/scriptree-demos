{
  "schema_version": 3,
  "name": "Hidden Assets & Notes Purger (PowerPoint)",
  "description": "Produces a sanitized copy of the open PowerPoint deck with speaker notes, comments, author/document metadata, and (optionally) hidden slides stripped out. Use it before sending a deck outside your organisation so private notes, reviewer comments, and the author's name don't leak.\n\nYour open deck is NEVER modified. The tool saves a sibling file named '<name>_Sanitized.pptx' in the same folder and does all of its stripping on that copy, then leaves your original exactly as it was.\n\nWhich assets are removed is controlled by the checkboxes below (notes, comments, and metadata are removed by default; deleting hidden slides is opt-in because it is permanent on the copy). Requires combridge (bundled with ScripTree at lib/combridge) and the target deck already open in a running PowerPoint instance, saved at least once.",
  "executable": "python",
  "working_directory": ".",
  "argument_template": [
    "ppt_purger.py",
    "{strip_notes?--strip-notes}",
    "{strip_comments?--strip-comments}",
    "{strip_metadata?--strip-metadata}",
    "{delete_hidden_slides?--delete-hidden-slides}",
    [
      "--output-format",
      "{output_format}"
    ]
  ],
  "params": [
    {
      "id": "strip_notes",
      "label": "Remove speaker notes",
      "description": "Clear the speaker-notes text from every slide in the sanitized copy. Notes often contain private talking points, internal figures, or reminders you don't want to share.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true,
      "section": "What to strip"
    },
    {
      "id": "strip_comments",
      "label": "Remove comments",
      "description": "Delete reviewer comments from every slide in the sanitized copy. Reaches PowerPoint's classic comment collection; very recent 'modern threaded' comments may not all be exposed to automation and could survive \u2014 spot-check the copy if your deck uses them heavily.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true,
      "section": "What to strip"
    },
    {
      "id": "strip_metadata",
      "label": "Strip author & document metadata",
      "description": "Remove author name, company, last-saved-by, revision history, and other document properties from the sanitized copy (PowerPoint's 'Remove All Document Information'). Recommended before any external send.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true,
      "section": "What to strip"
    },
    {
      "id": "delete_hidden_slides",
      "label": "Permanently delete hidden slides",
      "description": "OPT-IN. Delete every slide marked hidden from the sanitized copy. Hidden slides frequently hold backup numbers, draft content, or appendix material you didn't intend to circulate. Off by default because deletion on the copy is permanent; your original is still untouched.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Slides & output"
    },
    {
      "id": "output_format",
      "label": "Output format",
      "description": "How the result summary is rendered in the output pane. 'Markdown' is easy to paste into notes; 'Plain text' is a simple aligned list.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "markdown",
      "choices": [
        "markdown",
        "text"
      ],
      "choice_labels": [
        "Markdown",
        "Plain text"
      ],
      "section": "Slides & output"
    }
  ],
  "sections": [
    {
      "name": "What to strip",
      "layout": "collapse"
    },
    {
      "name": "Slides & output",
      "layout": "collapse"
    }
  ],
  "source": {
    "mode": "manual",
    "help_text_cached": null
  },
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "category": "MSOffice/PowerPoint"
}