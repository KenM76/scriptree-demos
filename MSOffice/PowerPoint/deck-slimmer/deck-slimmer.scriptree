{
  "schema_version": 3,
  "name": "Slide Deck Slimmer (PowerPoint)",
  "description": "Reduces the SAVED FILE SIZE of the open PowerPoint deck by removing UNUSED custom slide layouts \u2014 and, optionally, any design/master left with no layouts in use. Template-heavy decks carry many layouts no slide uses, and each unused layout can drag along its own background images and logos, bloating the file.\n\nBy default the tool works on a COPY: it saves a sibling file named '<name>_Slimmed.pptx' in the same folder and does all editing there, leaving your open deck untouched. Untick 'Work on a copy' to slim the open deck in place (it is left open and UNSAVED for you to review).\n\nIMPORTANT: this tool does NOT recompress images or media. PowerPoint exposes picture recompression only through an interactive 'Compress Pictures' dialog that cannot be driven automatically, so no image recompression is performed \u2014 the size reduction comes solely from removing unused layouts (and empty designs/masters). It is conservative: a layout is deleted only when no slide uses it, the last layout of a master is always kept, and on any uncertainty the layout is kept.\n\nRequires combridge (bundled with ScripTree at lib/combridge) and the target deck already open in a running PowerPoint instance (saved at least once if you keep 'Work on a copy' on).",
  "executable": "python",
  "working_directory": ".",
  "argument_template": [
    "slim_deck.py",
    "{remove_unused_layouts?--remove-unused-layouts}",
    "{remove_empty_masters?--remove-empty-masters}",
    "{work_on_copy?--work-on-copy}",
    [
      "--output-format",
      "{output_format}"
    ]
  ],
  "params": [
    {
      "id": "remove_unused_layouts",
      "label": "Remove unused custom layouts",
      "description": "Delete every custom slide layout that no slide uses. This is the main slimming action \u2014 unused layouts often carry background images and logos that bloat the file. Conservative: a layout is removed only when no slide demonstrably uses it, the last remaining layout of a master is always kept, and on any uncertainty the layout is kept.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true
    },
    {
      "id": "remove_empty_masters",
      "label": "Also remove empty designs / slide masters",
      "description": "OPT-IN, more aggressive. After the layout purge, delete any design (slide master) that has zero layouts left AND that no slide uses. Off by default. The last remaining design is always kept.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": false
    },
    {
      "id": "work_on_copy",
      "label": "Work on a copy (leave my open deck untouched)",
      "description": "ON (recommended): save a sibling '<name>_Slimmed.pptx' and do all editing on that copy \u2014 your open deck is never modified. Requires the deck to have been saved at least once. OFF: slim the open deck in place; it is left open and UNSAVED so you can review and decide whether to keep the changes.",
      "type": "boolean",
      "widget": "checkbox",
      "required": false,
      "default": true
    },
    {
      "id": "output_format",
      "label": "Output format",
      "description": "How the result summary is rendered in the output pane. 'Markdown' is easy to paste into notes; 'Plain text' is a simple aligned list.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "markdown",
      "choices": [
        "markdown",
        "text"
      ],
      "choice_labels": [
        "Markdown",
        "Plain text"
      ]
    }
  ],
  "source": {
    "mode": "manual",
    "help_text_cached": null
  },
  "cell": {
    "icon_data": "",
    "icon_format": "png"
  },
  "category": "MSOffice/PowerPoint"
}