{
  "schema_version": 2,
  "name": "eza",
  "description": "A modern, more-featureful ls. Sensible colours, file-type icons, Git integration, recursive tree view, and rich long-format columns. One-shot CLI: every flag is a presentation knob. Source: https://github.com/eza-community/eza",
  "executable": "./eza.exe",
  "working_directory": null,
  "sections": [
    { "name": "Target", "layout": "tab" },
    { "name": "Layout", "layout": "tab" },
    { "name": "Filtering & sort", "layout": "tab" },
    { "name": "Symlinks", "layout": "tab" },
    { "name": "Appearance", "layout": "tab" },
    { "name": "Long format", "layout": "tab" },
    { "name": "Time", "layout": "tab" },
    { "name": "Git", "layout": "tab" }
  ],
  "argument_template": [
    "{oneline?-1}",
    "{long?-l}",
    "{grid?-G}",
    "{recurse?-R}",
    "{tree?-T}",
    ["-L", "{level}"],
    "{across?-x}",
    "{all?-a}",
    "{all_twice?-aa}",
    "{almost_all?-A}",
    "{treat_dirs_as_files?-d}",
    "{reverse?-r}",
    ["-s", "{sort}"],
    ["-I", "{ignore_glob}"],
    "{git_ignore?--git-ignore}",
    "{group_dirs_first?--group-directories-first}",
    "{group_dirs_last?--group-directories-last}",
    "{only_dirs?-D}",
    "{only_files?-f}",
    "{show_symlinks?--show-symlinks}",
    "{no_symlinks?--no-symlinks}",
    "{follow_symlinks?--follow-symlinks}",
    "{dereference?-X}",
    ["--classify", "{classify}"],
    ["--color", "{color}"],
    ["--color-scale", "{color_scale}"],
    ["--color-scale-mode", "{color_scale_mode}"],
    ["--icons", "{icons}"],
    ["--hyperlink", "{hyperlink}"],
    "{no_quotes?--no-quotes}",
    ["-w", "{width}"],
    "{header?-h}",
    "{binary?-b}",
    "{bytes?-B}",
    "{group?-g}",
    "{smart_group?--smart-group}",
    "{links?-H}",
    "{inode?-i}",
    "{numeric?-n}",
    "{octal_permissions?-o}",
    "{flags?-O}",
    "{blocksize?-S}",
    "{mounts?-M}",
    "{extended?-@}",
    "{context?-Z}",
    "{total_size?--total-size}",
    "{no_permissions?--no-permissions}",
    "{no_filesize?--no-filesize}",
    "{no_user?--no-user}",
    "{no_time?--no-time}",
    ["-t", "{time}"],
    ["--time-style", "{time_style}"],
    "{accessed?-u}",
    "{created?-U}",
    "{changed?--changed}",
    "{modified?-m}",
    "{git?--git}",
    "{git_repos?--git-repos}",
    "{git_repos_no_status?--git-repos-no-status}",
    "{no_git?--no-git}",
    "{stdin?--stdin}",
    "{paths}"
  ],
  "params": [
    {
      "id": "paths",
      "label": "Path(s)",
      "description": "Files or directories to list. Space-separated. Defaults to the current directory if blank.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Target"
    },
    {
      "id": "stdin",
      "label": "Read paths from stdin (--stdin)",
      "description": "Read newline-separated paths from stdin instead of (or in addition to) the positional list. Lets you pipe `fd ... | eza --stdin -l`.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Target"
    },
    {
      "id": "long",
      "label": "Long format (-l / --long)",
      "description": "ls -l-style table with permissions, owner, size, mtime. Most of the columns in the 'Long format' section below only render with this on.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Layout"
    },
    {
      "id": "grid",
      "label": "Grid (-G / --grid)",
      "description": "Multi-column grid output. eza's default if neither --long nor --oneline is set.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Layout"
    },
    {
      "id": "oneline",
      "label": "One entry per line (-1 / --oneline)",
      "description": "Print exactly one entry per line. Friendly for piping or for narrow terminals.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Layout"
    },
    {
      "id": "across",
      "label": "Sort across (-x / --across)",
      "description": "Lay the grid out left-to-right (across) instead of top-to-bottom (down).",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Layout"
    },
    {
      "id": "recurse",
      "label": "Recurse (-R / --recurse)",
      "description": "Descend into subdirectories, listing each one in turn.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Layout"
    },
    {
      "id": "tree",
      "label": "Tree (-T / --tree)",
      "description": "Render the recursion as a tree.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Layout"
    },
    {
      "id": "level",
      "label": "Recursion depth (-L / --level)",
      "description": "Cap the recursion depth for --recurse / --tree.",
      "type": "integer",
      "widget": "number",
      "required": false,
      "default": 0,
      "min": 1,
      "max": 100,
      "section": "Layout"
    },
    {
      "id": "width",
      "label": "Width (-w / --width)",
      "description": "Force grid width in columns. Leave blank to detect from the terminal.",
      "type": "integer",
      "widget": "number",
      "required": false,
      "default": 0,
      "min": 20,
      "max": 400,
      "section": "Layout"
    },
    {
      "id": "all",
      "label": "Show hidden (-a / --all)",
      "description": "Include dotfiles in the listing.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filtering & sort"
    },
    {
      "id": "all_twice",
      "label": "Show . and .. too (-aa)",
      "description": "Equivalent to passing -a twice. Includes the . and .. entries (only useful with --long, otherwise eza already shows them).",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filtering & sort"
    },
    {
      "id": "almost_all",
      "label": "Almost all (-A / --almost-all)",
      "description": "ls-compat alias for --all.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filtering & sort"
    },
    {
      "id": "treat_dirs_as_files",
      "label": "Treat dirs as files (-d / --treat-dirs-as-files)",
      "description": "Print directories themselves rather than recursing into them. Mirrors `ls -d`.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filtering & sort"
    },
    {
      "id": "ignore_glob",
      "label": "Ignore glob (-I / --ignore-glob)",
      "description": "Pipe-separated globs to skip. Example: 'node_modules|target|*.lock'.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Filtering & sort"
    },
    {
      "id": "git_ignore",
      "label": "Respect .gitignore (--git-ignore)",
      "description": "Hide entries that .gitignore would exclude.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filtering & sort"
    },
    {
      "id": "only_dirs",
      "label": "Only directories (-D / --only-dirs)",
      "description": "Hide files; show only directories.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filtering & sort"
    },
    {
      "id": "only_files",
      "label": "Only files (-f / --only-files)",
      "description": "Hide directories; show only files.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filtering & sort"
    },
    {
      "id": "group_dirs_first",
      "label": "Directories first (--group-directories-first)",
      "description": "List directories before files in the sorted output.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filtering & sort"
    },
    {
      "id": "group_dirs_last",
      "label": "Directories last (--group-directories-last)",
      "description": "List directories after files in the sorted output.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filtering & sort"
    },
    {
      "id": "sort",
      "label": "Sort (-s / --sort)",
      "description": "Sort field. 'Name'/'Extension' (capitalised) sort case-insensitively; lower-case versions are case-sensitive.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "",
      "choices": [
        "",
        "name",
        "Name",
        "extension",
        "Extension",
        "size",
        "modified",
        "changed",
        "accessed",
        "created",
        "inode",
        "type",
        "none"
      ],
      "section": "Filtering & sort"
    },
    {
      "id": "reverse",
      "label": "Reverse sort (-r / --reverse)",
      "description": "Reverse whichever sort is in effect.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Filtering & sort"
    },
    {
      "id": "follow_symlinks",
      "label": "Follow symlinks (--follow-symlinks)",
      "description": "When a symlink points at a directory, descend into it (with --recurse / --tree).",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Symlinks"
    },
    {
      "id": "dereference",
      "label": "Dereference (-X / --dereference)",
      "description": "Show metadata of the link target rather than the link itself.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Symlinks"
    },
    {
      "id": "show_symlinks",
      "label": "Show symlinks (--show-symlinks)",
      "description": "Explicitly include symlinks in output.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Symlinks"
    },
    {
      "id": "no_symlinks",
      "label": "Hide symlinks (--no-symlinks)",
      "description": "Exclude symlinks from output entirely.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Symlinks"
    },
    {
      "id": "color",
      "label": "Color (--color / --colour)",
      "description": "When to use ANSI colors.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "",
      "choices": [
        "",
        "auto",
        "always",
        "never"
      ],
      "section": "Appearance"
    },
    {
      "id": "color_scale",
      "label": "Color scale (--color-scale)",
      "description": "Comma-separated fields to highlight in colour gradients. Common pick: 'all' or 'age,size'.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Appearance"
    },
    {
      "id": "color_scale_mode",
      "label": "Color scale mode (--color-scale-mode)",
      "description": "How to map field values to colours. 'gradient' (default) maps continuously; 'fixed' uses bucketed colours.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "",
      "choices": [
        "",
        "gradient",
        "fixed"
      ],
      "section": "Appearance"
    },
    {
      "id": "icons",
      "label": "Icons (--icons)",
      "description": "Show file-type icons (requires a Nerd-Font terminal).",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "",
      "choices": [
        "",
        "auto",
        "always",
        "never"
      ],
      "section": "Appearance"
    },
    {
      "id": "classify",
      "label": "Classify (-F / --classify)",
      "description": "Append a single character to entries indicating their type (* / @ | etc.).",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "",
      "choices": [
        "",
        "auto",
        "always",
        "never"
      ],
      "section": "Appearance"
    },
    {
      "id": "hyperlink",
      "label": "Hyperlink (--hyperlink)",
      "description": "Render entries as OSC 8 terminal hyperlinks.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "",
      "choices": [
        "",
        "auto",
        "always",
        "never"
      ],
      "section": "Appearance"
    },
    {
      "id": "no_quotes",
      "label": "No quotes around names (--no-quotes)",
      "description": "Don't wrap names containing spaces in quotes.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Appearance"
    },
    {
      "id": "header",
      "label": "Show column header (-h / --header)",
      "description": "Print a header row labelling each column. Only renders with --long.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "binary",
      "label": "Binary sizes (-b / --binary)",
      "description": "Use KiB / MiB / GiB (powers of 1024). Requires --long.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "bytes",
      "label": "Raw bytes (-B / --bytes)",
      "description": "Print sizes as raw byte counts. Requires --long.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "group",
      "label": "Show group (-g / --group)",
      "description": "Add a group column. Requires --long.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "smart_group",
      "label": "Smart group (--smart-group)",
      "description": "Show the group only when it differs from the owner. Requires --long.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "links",
      "label": "Hard-link count (-H / --links)",
      "description": "Show each file's hard-link count. Requires --long.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "inode",
      "label": "Inode (-i / --inode)",
      "description": "Show each file's inode. Requires --long.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "numeric",
      "label": "Numeric uid/gid (-n / --numeric)",
      "description": "Display numeric user and group IDs.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "octal_permissions",
      "label": "Octal permissions (-o / --octal-permissions)",
      "description": "Show permissions as a four-digit octal value.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "flags",
      "label": "Flags / xattrs (-O / --flags)",
      "description": "On macOS/BSD: BSD file flags. On Windows: file attributes.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "blocksize",
      "label": "Allocated blocks (-S / --blocksize)",
      "description": "Show each file's allocated block count.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "mounts",
      "label": "Mount details (-M / --mounts)",
      "description": "Show device/mount details for mount points (Linux/macOS only).",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "extended",
      "label": "Extended attributes (-@ / --extended)",
      "description": "List extended attributes and their sizes.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "context",
      "label": "Security context (-Z / --context)",
      "description": "Show each file's SELinux/AppArmor security context.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "total_size",
      "label": "Recursive size (--total-size)",
      "description": "Show the total recursive size of each directory (Unix only).",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "no_permissions",
      "label": "Hide permissions (--no-permissions)",
      "description": "Don't print the permissions column.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "no_filesize",
      "label": "Hide filesize (--no-filesize)",
      "description": "Don't print the size column.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "no_user",
      "label": "Hide user (--no-user)",
      "description": "Don't print the user column.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "no_time",
      "label": "Hide time (--no-time)",
      "description": "Don't print the time column.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Long format"
    },
    {
      "id": "time",
      "label": "Time field (-t / --time)",
      "description": "Which timestamp to show in the long view.",
      "type": "enum",
      "widget": "dropdown",
      "required": false,
      "default": "",
      "choices": [
        "",
        "modified",
        "changed",
        "accessed",
        "created"
      ],
      "section": "Time"
    },
    {
      "id": "time_style",
      "label": "Time style (--time-style)",
      "description": "Format for timestamp output. 'default' / 'iso' / 'long-iso' / 'full-iso' / 'relative' or a strftime '+FORMAT' string.",
      "type": "string",
      "widget": "text",
      "required": false,
      "default": "",
      "section": "Time"
    },
    {
      "id": "modified",
      "label": "Sort by modified (-m / --modified)",
      "description": "Use the modified timestamp.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Time"
    },
    {
      "id": "accessed",
      "label": "Sort by accessed (-u / --accessed)",
      "description": "Use the accessed timestamp.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Time"
    },
    {
      "id": "created",
      "label": "Sort by created (-U / --created)",
      "description": "Use the created timestamp (where the OS records it).",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Time"
    },
    {
      "id": "changed",
      "label": "Sort by changed (--changed)",
      "description": "Use the changed (ctime) timestamp.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Time"
    },
    {
      "id": "git",
      "label": "Git status per file (--git)",
      "description": "Show each file's Git tracking/staged/modified status. Requires --long.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Git"
    },
    {
      "id": "git_repos",
      "label": "Git status per repo (--git-repos)",
      "description": "For each directory, show its overall Git status if it's a repo root.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Git"
    },
    {
      "id": "git_repos_no_status",
      "label": "Mark repos only (--git-repos-no-status)",
      "description": "Mark directories that are Git repos without computing status (faster on big trees).",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Git"
    },
    {
      "id": "no_git",
      "label": "No Git (--no-git)",
      "description": "Disable all Git lookups, even when configured globally.",
      "type": "bool",
      "widget": "checkbox",
      "required": false,
      "default": false,
      "section": "Git"
    }
  ],
  "source": {
    "mode": "manual",
    "url": "https://github.com/eza-community/eza",
    "help_text_cached": "eza [OPTIONS] [FILES]...\n\nA modern, more-featureful ls.\n\nKey flags:\n  -1 -G -l -T          Layouts: oneline, grid, long, tree\n  -L N                 Limit recursion depth\n  -a / -aa             Show hidden / show . and ..\n  -s FIELD             Sort by name|size|modified|...\n  -I GLOBS             Pipe-separated ignore globs\n  --git-ignore         Respect .gitignore\n  --color WHEN         auto|always|never\n  --icons WHEN         auto|always|never (Nerd Font terminal)\n  --hyperlink WHEN     OSC 8 terminal hyperlinks\n  -h --header          Long view: column header\n  -b --binary          Long view: KiB/MiB/GiB sizes\n  -t FIELD             Long view: which timestamp\n  --time-style STYLE   default|iso|long-iso|full-iso|relative|+FMT\n  --git --git-repos    Long view: Git tracking columns"
  }
}
